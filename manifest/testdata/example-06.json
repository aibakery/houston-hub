{
  "schema_version": 1,
  "name": "ClickHouse",
  "description": "Query a ClickHouse database over HTTPS.",
  "files": [
    "connector.luau"
  ],
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "required": true,
      "order": 1
    },
    "database": {
      "type": "string",
      "label": "Database",
      "default": "default",
      "required": true,
      "order": 3
    },
    "username": {
      "type": "string",
      "label": "Username",
      "required": true,
      "order": 4
    },
    "password": {
      "type": "secret",
      "label": "Password",
      "required": true,
      "order": 5
    },
    "port": {
      "type": "integer",
      "label": "Port",
      "default": 8443,
      "minimum": 1,
      "maximum": 65535,
      "order": 2
    }
  },
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "{{config.database}}",
          "host": "{{config.host}}",
          "password": "{{config.password}}",
          "tls": {
            "mode": "verify-full"
          },
          "user": "{{config.username}}",
          "port": "{{config.port}}"
        }
      },
      "match": {
        "protocol": "clickhouse"
      }
    }
  ]
}
