{
  "schema_version": 1,
  "name": "ClickHouse",
  "description": "Query a ClickHouse database over HTTPS or native TLS.",
  "files": [
    "connector.luau"
  ],
  "config": {
    "host": {
      "type": "string",
      "label": "Host",
      "required": true,
      "order": 1
    },
    "transport": {
      "type": "string",
      "label": "Transport",
      "default": "https",
      "options": [
        {
          "value": "https",
          "label": "HTTPS"
        },
        {
          "value": "native",
          "label": "Native TLS"
        }
      ],
      "order": 2
    },
    "database": {
      "type": "string",
      "label": "Database",
      "default": "default",
      "required": true,
      "order": 3
    },
    "username": {
      "type": "string",
      "label": "Username",
      "required": true,
      "order": 4
    },
    "password": {
      "type": "secret",
      "label": "Password",
      "required": true,
      "order": 5
    }
  },
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "{{config.database}}",
          "host": "{{config.host}}",
          "password": "{{config.password}}",
          "tls": {
            "mode": "verify-full"
          },
          "transport": "{{config.transport}}",
          "user": "{{config.username}}"
        }
      },
      "match": {
        "protocol": "clickhouse"
      }
    }
  ]
}
