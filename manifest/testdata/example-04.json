{
  "schema_version": 1,
  "name": "Warehouse",
  "description": "Read warehouse inventory.",
  "files": [
    "connector.luau"
  ],
  "auth": {
    "basic": {
      "type": "manual",
      "label": "Warehouse credentials",
      "config": {
        "username": {
          "type": "string",
          "label": "Username",
          "required": true,
          "order": 1
        },
        "password": {
          "type": "secret",
          "label": "Password",
          "required": true,
          "order": 2
        }
      }
    }
  },
  "proxy": [
    {
      "action": {
        "basic_auth": {
          "password": "{{auth.basic.password}}",
          "username": "{{auth.basic.username}}"
        }
      },
      "match": {
        "host": [
          "warehouse.example.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/items",
          "/items/{id}"
        ],
        "protocol": "http"
      }
    }
  ]
}
