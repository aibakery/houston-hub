{
  "schema_version": 1,
  "name": "Inventory Database",
  "description": "Query the inventory MySQL database.",
  "files": [
    "connector.luau"
  ],
  "config": {
    "username": {
      "type": "string",
      "label": "Username",
      "required": true,
      "order": 1
    },
    "password": {
      "type": "secret",
      "label": "Password",
      "required": true,
      "order": 2
    }
  },
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "inventory",
          "host": "inventory-db.example.com",
          "password": "{{config.password}}",
          "tls": {
            "mode": "verify-full"
          },
          "user": "{{config.username}}"
        }
      },
      "match": {
        "protocol": "mysql"
      }
    }
  ]
}
