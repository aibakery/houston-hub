{
  "auth": {
    "api_key": {
      "config": {
        "token": {
          "label": "API key",
          "order": 2,
          "placeholder": "Paste your API key",
          "required": true,
          "type": "secret"
        }
      },
      "label": "API key",
      "order": 1,
      "type": "manual"
    },
    "oauth": {
      "authorize_url": "https://accounts.files.example.com/oauth/authorize",
      "client_auth": "basic",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "label": "Sign in with Example",
      "order": 2,
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "files.read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "files.write"
          ]
        }
      ],
      "token_url": "https://accounts.files.example.com/oauth/token",
      "type": "oauth2"
    }
  },
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    },
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "type": "secret"
    },
    "page_size": {
      "default": 50,
      "label": "Page size",
      "maximum": 100,
      "minimum": 1,
      "order": 3,
      "type": "integer"
    }
  },
  "description": "Read files and optionally upload or change them.",
  "files": [
    "connector.luau"
  ],
  "name": "Example Files",
  "proxy": [
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization",
            "X-API-Key"
          ],
          "set": {
            "Accept": "application/json",
            "Authorization": "Bearer {{auth.oauth.access_token}}",
            "X-Service-Region": "us"
          }
        }
      },
      "if": "{{ and (is publisher.region \"us\") (isDefined auth.oauth) }}",
      "match": {
        "host": [
          "api.files.example.com"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization",
            "X-API-Key"
          ],
          "set": {
            "Accept": "application/json",
            "X-API-Key": "{{auth.api_key.token}}",
            "X-Service-Region": "us"
          }
        }
      },
      "if": "{{ and (is publisher.region \"us\") (isDefined auth.api_key) }}",
      "match": {
        "host": [
          "api.files.example.com"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "X-Download-Token": "{{auth.api_key.token || auth.oauth.access_token}}"
          }
        }
      },
      "if": "{{ is publisher.region \"us\" }}",
      "match": {
        "host": [
          "downloads.us.files.example.com"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {},
      "if": "{{ is publisher.region \"us\" }}",
      "match": {
        "host": [
          "uploads.us.files.example.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/signed/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization",
            "X-API-Key"
          ],
          "set": {
            "Accept": "application/json",
            "Authorization": "Bearer {{auth.oauth.access_token}}",
            "X-Service-Region": "eu"
          }
        }
      },
      "if": "{{ and (is publisher.region \"eu\") (isDefined auth.oauth) }}",
      "match": {
        "host": [
          "api.files.example.com"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization",
            "X-API-Key"
          ],
          "set": {
            "Accept": "application/json",
            "X-API-Key": "{{auth.api_key.token}}",
            "X-Service-Region": "eu"
          }
        }
      },
      "if": "{{ and (is publisher.region \"eu\") (isDefined auth.api_key) }}",
      "match": {
        "host": [
          "api.files.example.com"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "X-Download-Token": "{{auth.api_key.token || auth.oauth.access_token}}"
          }
        }
      },
      "if": "{{ is publisher.region \"eu\" }}",
      "match": {
        "host": [
          "downloads.eu.files.example.com"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {},
      "if": "{{ is publisher.region \"eu\" }}",
      "match": {
        "host": [
          "uploads.eu.files.example.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/signed/*"
        ],
        "protocol": "http"
      }
    }
  ],
  "publisher": {
    "region": {
      "default": "us",
      "label": "Service region",
      "options": [
        {
          "label": "United States",
          "value": "us"
        },
        {
          "label": "Europe",
          "value": "eu"
        }
      ],
      "order": 0,
      "type": "string"
    }
  },
  "schema_version": 1,
  "setup": "Choose an API key or authorize your Example Files account."
}
