{
  "$defs": {
    "AccessRow": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "levels": {
          "description": "Levels from least to most access; none, when present, comes first.",
          "items": {
            "$ref": "#/$defs/Option"
          },
          "maxItems": 4,
          "minItems": 2,
          "type": "array"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "levels",
        "default"
      ],
      "type": "object"
    },
    "AuthAvailability": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "preview",
            "disabled"
          ],
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "AuthMethod": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "manual"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "account": false,
              "api_key": false,
              "app": false,
              "auth_config_id": false,
              "authorize_params": false,
              "authorize_url": false,
              "brand": false,
              "client_auth": false,
              "client_id": false,
              "client_secret": false,
              "pkce": false,
              "refresh_params": false,
              "refresh_response": false,
              "require_refresh": false,
              "scope_parameter": false,
              "scope_separator": false,
              "scopes": false,
              "shared": false,
              "token_encoding": false,
              "token_headers": false,
              "token_params": false,
              "token_response": false,
              "token_url": false
            },
            "required": [
              "config"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "oauth2"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "api_key": false,
              "app": false,
              "auth_config_id": false,
              "config": false,
              "setup_params": false,
              "setup_url": false
            },
            "required": [
              "authorize_url",
              "token_url",
              "client_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "composio"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "authorize_params": false,
              "authorize_url": false,
              "client_auth": false,
              "client_id": false,
              "client_secret": false,
              "config": false,
              "pkce": false,
              "refresh_params": false,
              "refresh_response": false,
              "require_refresh": false,
              "scope_parameter": false,
              "scope_separator": false,
              "scopes": false,
              "setup_params": false,
              "setup_url": false,
              "shared": false,
              "token_encoding": false,
              "token_headers": false,
              "token_params": false,
              "token_response": false,
              "token_url": false
            },
            "required": [
              "api_key",
              "auth_config_id",
              "app"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "oauth2"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "else": {
              "required": [
                "client_secret"
              ]
            },
            "if": {
              "properties": {
                "client_auth": {
                  "const": "none"
                }
              },
              "required": [
                "client_auth"
              ]
            },
            "then": {
              "properties": {
                "client_secret": false,
                "pkce": {
                  "const": "S256"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "account": {
          "$ref": "#/$defs/OAuthAccount"
        },
        "api_key": {
          "type": "string"
        },
        "app": {
          "type": "string"
        },
        "auth_config_id": {
          "type": "string"
        },
        "authorize_params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "authorize_url": {
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/AuthAvailability"
        },
        "brand": {
          "enum": [
            "google",
            "microsoft",
            "dropbox",
            "slack",
            "notion",
            "github",
            "linear",
            "figma",
            "discord"
          ],
          "type": "string"
        },
        "client_auth": {
          "enum": [
            "basic",
            "body",
            "none"
          ],
          "type": "string"
        },
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "description": {
          "type": "string"
        },
        "if": {
          "pattern": "^\\s*\\{\\{.+\\}\\}\\s*$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "order": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "pkce": {
          "enum": [
            "S256",
            "none"
          ],
          "type": "string"
        },
        "refresh_params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "refresh_response": {
          "allOf": [
            {
              "$ref": "#/$defs/TokenResponse"
            },
            {
              "properties": {
                "facts": false,
                "label": false
              }
            }
          ]
        },
        "require_refresh": {
          "type": "boolean"
        },
        "scope_parameter": {
          "minLength": 1,
          "type": "string"
        },
        "scope_separator": {
          "minLength": 1,
          "type": "string"
        },
        "scopes": {
          "items": {
            "$ref": "#/$defs/ScopeGroup"
          },
          "type": "array"
        },
        "setup_params": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Manual methods only: query parameter to access row; the link carries each row's level except none.",
          "type": "object"
        },
        "setup_url": {
          "description": "Manual methods only: a literal HTTPS link where people create the credential.",
          "type": "string"
        },
        "shared": {
          "$ref": "#/$defs/OAuthShared"
        },
        "token_encoding": {
          "enum": [
            "form",
            "json"
          ],
          "type": "string"
        },
        "token_headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "token_params": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "token_response": {
          "$ref": "#/$defs/TokenResponse"
        },
        "token_url": {
          "type": "string"
        },
        "type": {
          "enum": [
            "manual",
            "oauth2",
            "composio"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "type": "object"
    },
    "BasicAuth": {
      "additionalProperties": false,
      "oneOf": [
        {
          "maxProperties": 0
        },
        {
          "required": [
            "username",
            "password"
          ]
        }
      ],
      "properties": {
        "password": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "ConnectionLabelRequest": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "body"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "POST"
              }
            },
            "required": [
              "method"
            ]
          }
        }
      ],
      "properties": {
        "body": {
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/HeaderValue"
          },
          "type": "object"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "type": "string"
        },
        "url": {
          "description": "HTTPS URL with a literal scheme and optional public connection references. Publisher credentials require a publisher-controlled recipient.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "ConnectionLabelRule": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "request": false,
            "select": false
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "value": false
          },
          "required": [
            "request",
            "select"
          ]
        }
      ],
      "properties": {
        "if": {
          "pattern": "^\\s*\\{\\{.+\\}\\}\\s*$",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ConnectionLabelRequest"
        },
        "select": {
          "pattern": "^(?:/(?:[^~]|~[01])*)+$",
          "type": "string"
        },
        "value": {
          "description": "Literal or template using public connection config or selected auth fields; secrets and publisher fields are forbidden.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "DatabaseConnection": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "port": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "tls": {
          "$ref": "#/$defs/TLS"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "host",
        "user",
        "password"
      ],
      "type": "object"
    },
    "Field": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "default": false,
              "display": false,
              "options": false
            }
          }
        },
        {
          "else": {
            "properties": {
              "display": false,
              "max_length": false,
              "min_length": false,
              "options": false,
              "placeholder": false
            }
          },
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "secret"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "maximum": false,
              "minimum": false
            }
          }
        },
        {
          "if": {
            "required": [
              "options"
            ]
          },
          "then": {
            "properties": {
              "display": false
            }
          }
        },
        {
          "if": {
            "required": [
              "multiline"
            ]
          },
          "then": {
            "properties": {
              "display": {
                "const": "plain"
              },
              "options": false,
              "type": {
                "const": "string"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "multiline": {
                "const": true
              }
            },
            "required": [
              "multiline"
            ]
          }
        }
      ],
      "properties": {
        "default": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        },
        "description": {
          "type": "string"
        },
        "display": {
          "enum": [
            "plain",
            "masked"
          ],
          "type": "string"
        },
        "format": {
          "description": "json requires valid JSON and pem one or more PEM certificates; the string value is preserved and connectors validate its meaning.",
          "enum": [
            "json",
            "pem"
          ],
          "type": "string"
        },
        "if": {
          "pattern": "^\\s*\\{\\{.+\\}\\}\\s*$",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "max_length": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "maximum": {
          "type": "number"
        },
        "min_length": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "minimum": {
          "type": "number"
        },
        "multiline": {
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "minItems": 1,
          "type": "array"
        },
        "order": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "placeholder": {
          "type": "string"
        },
        "reauthorize_on_change": {
          "description": "Config fields only. false lets a change to this field save on an OAuth or Composio connection without asking the account holder to authorize again; every other change re-authorizes. Only valid when no scope group, proxy rule, auth method or other field references the field.",
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer",
            "number",
            "secret"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "label"
      ],
      "type": "object"
    },
    "HeaderActions": {
      "additionalProperties": false,
      "properties": {
        "remove": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "set": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/HeaderValue"
              }
            ]
          },
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "HeaderValue": {
      "additionalProperties": false,
      "properties": {
        "if": {
          "pattern": "^\\s*\\{\\{.+\\}\\}\\s*$",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "description": "The access matrix: rows the user sets to one level each, ordered by display. Predicates read them with {{ allows access.\u003crow\u003e \"\u003clevel\u003e\" }}; is access.\u003crow\u003e is allowed only on scope groups.",
          "items": {
            "$ref": "#/$defs/AccessRow"
          },
          "maxItems": 32,
          "type": "array"
        },
        "auth": {
          "additionalProperties": {
            "$ref": "#/$defs/AuthMethod"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "connection_label": {
          "description": "Optional presentation rules. The first matching rule is the only source; absent, empty or failed results show no label. Rules never alter authorization or connection readiness.",
          "items": {
            "$ref": "#/$defs/ConnectionLabelRule"
          },
          "type": "array"
        },
        "connections": {
          "description": "Which connections Houston accepts: personal-only, shared-only, or unrestricted (the default). Set personal-only when the provider forbids sharing one person's authorization with other users.",
          "enum": [
            "unrestricted",
            "personal-only",
            "shared-only"
          ],
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "icon": {
          "enum": [
            "icon.svg",
            "icon.png"
          ],
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "proxy": {
          "items": {
            "$ref": "#/$defs/Proxy"
          },
          "minItems": 1,
          "type": "array"
        },
        "publisher": {
          "additionalProperties": {
            "$ref": "#/$defs/Field"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "schema_version": {
          "const": 2
        },
        "setup": {
          "type": "string"
        },
        "stateless": {
          "type": "boolean"
        },
        "verification_key": {
          "minLength": 1,
          "type": "string"
        },
        "warning": {
          "description": "Markdown notice shown prominently wherever people set up or review this connector, such as a pending provider approval that affects their experience.",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "name",
        "files",
        "proxy"
      ],
      "type": "object"
    },
    "OAuthAccount": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ResponseCheck"
          },
          "type": "array"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/HeaderValue"
          },
          "type": "object"
        },
        "label": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "label"
      ],
      "type": "object"
    },
    "OAuthShared": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "additionalProperties": {
            "type": [
              "string",
              "boolean",
              "number"
            ]
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "$ref": "#/$defs/HeaderValue"
          },
          "type": "object"
        },
        "items": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "items"
      ],
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "Proxy": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "action": {
                "properties": {
                  "basic_auth": false,
                  "headers": false,
                  "query": false,
                  "rewrite": false
                },
                "required": [
                  "connection"
                ]
              },
              "match": {
                "properties": {
                  "colon_path_parameters": false,
                  "header": false,
                  "host": false,
                  "method": false,
                  "opaque_path_parameters": false,
                  "path": false
                }
              }
            }
          },
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "protocol": {
                    "const": "http"
                  }
                },
                "required": [
                  "protocol"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "connection": false
                }
              },
              "match": {
                "required": [
                  "host"
                ]
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "action": {
                "properties": {
                  "connection": {
                    "required": [
                      "database"
                    ]
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "match": {
                "properties": {
                  "protocol": {
                    "const": "imap"
                  }
                },
                "required": [
                  "protocol"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "properties": {
                  "connection": {
                    "properties": {
                      "database": false
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ProxyAction"
        },
        "if": {
          "pattern": "^\\s*\\{\\{.+\\}\\}\\s*$",
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/ProxyMatch"
        }
      },
      "required": [
        "match",
        "action"
      ],
      "type": "object"
    },
    "ProxyAction": {
      "additionalProperties": false,
      "properties": {
        "basic_auth": {
          "$ref": "#/$defs/BasicAuth"
        },
        "connection": {
          "$ref": "#/$defs/DatabaseConnection"
        },
        "headers": {
          "$ref": "#/$defs/HeaderActions"
        },
        "query": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "rewrite": {
          "$ref": "#/$defs/Rewrite"
        }
      },
      "required": [],
      "type": "object"
    },
    "ProxyMatch": {
      "additionalProperties": false,
      "properties": {
        "colon_path_parameters": {
          "description": "Placeholder names whose values may contain a colon, plain or percent-encoded, such as a URN; other placeholders, bare or before a {name}:verb suffix, refuse colons. Opaque parameters already accept colons and cannot be repeated here.",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "header": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "const": true
              }
            ]
          },
          "type": "object"
        },
        "host": {
          "description": "Hostnames with optional ports; HTTPS only. Leading *. matches subdomains, not the base host. A template such as {{config.host}} renders one exact origin per connection.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "method": {
          "items": {
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "opaque_path_parameters": {
          "items": {
            "pattern": "^(\\*|[A-Za-z_][A-Za-z0-9_]*)$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "path": {
          "description": "Path patterns. A whole segment such as {{auth.oauth.team_id}} names one declared OAuth fact, rendered per connection. {name}:verb matches a custom method, such as /items/{id}:archive.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "protocol": {
          "enum": [
            "http",
            "postgres",
            "mysql",
            "clickhouse",
            "redis",
            "imap"
          ],
          "type": "string"
        }
      },
      "required": [
        "protocol"
      ],
      "type": "object"
    },
    "ResponseCheck": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "value": false
            }
          },
          "if": {
            "properties": {
              "op": {
                "const": "equals"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        }
      ],
      "properties": {
        "op": {
          "enum": [
            "exists",
            "equals"
          ],
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "boolean",
            "number"
          ]
        }
      },
      "required": [
        "path",
        "op"
      ],
      "type": "object"
    },
    "Rewrite": {
      "additionalProperties": false,
      "properties": {
        "strip_prefix": {
          "type": "string"
        }
      },
      "required": [
        "strip_prefix"
      ],
      "type": "object"
    },
    "ScopeGroup": {
      "additionalProperties": false,
      "properties": {
        "if": {
          "pattern": "^\\s*\\{\\{.+\\}\\}\\s*$",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    },
    "TLS": {
      "additionalProperties": false,
      "properties": {
        "ca": {
          "description": "PEM certificates that replace the trusted authorities, or one reference to a pem-formatted config or publisher field.",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "verify-full",
                "verify-ca",
                "require"
              ]
            },
            {
              "pattern": "^\\{\\{.+\\}\\}$"
            }
          ],
          "description": "A TLS mode, or one reference to a config or publisher field whose options are TLS modes.",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "TokenResponse": {
      "additionalProperties": false,
      "properties": {
        "access_token": {
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ResponseCheck"
          },
          "type": "array"
        },
        "expires_in": {
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Public string values from the initial token response, bound to the connection; method oauth exposes fact team_id as {{auth.oauth.team_id}}.",
          "maxProperties": 16,
          "propertyNames": {
            "not": {
              "enum": [
                "access_token",
                "refresh_token"
              ]
            },
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "label": {
          "description": "Account label from the initial token response, when no account request is declared.",
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "scopes": {
          "type": "string"
        },
        "scopes_unreported": {
          "description": "token_response only: the provider reports granted scopes unreliably, so Houston keeps the requested scopes on the exchange and the previous ones on refresh. Requires checks that prove the grant; forbids scopes.",
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    }
  },
  "$id": "https://ok-houston.com/schemas/connector-manifest-v2.json",
  "$ref": "#/$defs/Manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Houston connector manifest v2"
}
