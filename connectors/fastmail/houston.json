  "description": "Find the conversations you need, keep your inbox organized, and reply to emails from Houston.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "implements": [
    "mail.folders@1"
  ],
  "name": "Fastmail",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.fastmail.com",
          "*.api.fastmail.com",
          "jmap.fastmail.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/jmap/session",
          "/jmap/download/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.fastmail.com",
          "*.api.fastmail.com",
          "jmap.fastmail.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/jmap/api",
          "/jmap/api/",
          "/jmap/upload/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "fastmailusercontent.com",
          "*.fastmailusercontent.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/jmap/download/*"
        ],
        "protocol": "http"
      }
    }
  ],
  "schema_version": 1,
  "setup": "In Fastmail Settings → Privacy \u0026 Security → Manage API tokens, select the JMAP protocol and enable Email, Email submission, and Masked Email. MCP and Dynamic DNS tokens are not supported. Choose Read-only access for reading, or Read-write access to send, reply, move, archive, or delete mail. API tokens require a plan above Basic. Your token stays on this server.",
