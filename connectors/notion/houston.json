{
  "schema_version": 1,
  "name": "Notion",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    }
  },
  "auth": {
    "admin": {
      "config": {
        "token": {
          "label": "Token",
          "required": true,
          "type": "secret"
        }
      },
      "label": "Enterprise organization bot (Admin API)",
      "order": 3,
      "type": "manual"
    },
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          },
          "Notion-Version": {
            "value": "2026-03-11"
          }
        },
        "label": "/id",
        "method": "GET",
        "url": "https://api.notion.com/v1/users/me"
      },
      "authorize_params": {
        "owner": "user"
      },
      "authorize_url": "https://api.notion.com/v1/oauth/authorize",
      "client_auth": "basic",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "if": "{{ isDefined publisher.client_id }}",
      "label": "Connect with Notion",
      "order": 2,
      "pkce": "none",
      "token_encoding": "json",
      "token_headers": {
        "Notion-Version": "2026-03-11"
      },
      "token_url": "https://api.notion.com/v1/oauth/token",
      "type": "oauth2"
    },
    "token": {
      "config": {
        "token": {
          "label": "Token",
          "required": true,
          "type": "secret"
        }
      },
      "label": "Internal connection or personal access token",
      "order": 1,
      "type": "manual"
    }
  },
  "publisher": {
    "client_id": {
      "label": "OAuth client ID (optional)",
      "type": "string"
    },
    "client_secret": {
      "if": "{{ isDefined publisher.client_id }}",
      "label": "OAuth client secret",
      "required": true,
      "type": "secret"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}",
            "Notion-Version": "2026-03-11"
          }
        }
      },
      "if": "{{ isDefined auth.token }}",
      "match": {
        "host": ["api.notion.com"],
        "method": ["GET"],
        "path": ["/v1/pages/{page_id}/properties/{property_id}"],
        "opaque_path_parameters": ["property_id"],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}",
            "Notion-Version": "2026-03-11"
          }
        }
      },
