{
  "schema_version": 1,
  "name": "Granola",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "auth": {
    "token": {
      "type": "manual",
      "label": "API key",
      "config": {
        "token": {
          "type": "secret",
          "label": "API key",
          "description": "A Granola personal or workspace API key, starting with grn_.",
          "required": true
        }
      }
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "public-api.granola.ai"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/v1/folders",
          "/v1/notes",
          "/v1/notes/{note_id}",
          "/v1/notes/{note_id}/transcript",
          "/v1/spaces"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      }
    }
  ]
}
