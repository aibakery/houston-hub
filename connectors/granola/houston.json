{
  "auth": {
    "token": {
      "config": {
        "token": {
          "label": "API key",
          "required": true,
          "type": "secret"
        }
      },
      "label": "API key",
      "type": "manual"
    }
  },
  "description": "Read-only access to Granola notes, folders, and transcripts.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Granola",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "public-api.granola.ai"
        ],
        "method": [
          "GET",
          "HEAD"
        ],
        "path": [
          "/v1/*"
        ],
        "protocol": "http"
      }
    }
  ],
  "schema_version": 1,
  "setup": "The API key stays on this server. Houston reads notes from Granola; your notes stay in Granola."
}
