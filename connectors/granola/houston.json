{
  "auth": {
    "token": {
      "config": {
        "token": {
          "label": "API key",
          "required": true,
          "type": "secret"
        }
      },
      "label": "API key",
      "type": "manual"
    }
  },
  "description": "Read-only access to Granola notes, folders, and transcripts.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Granola",
  "proxy": [
    {
      "origins": {
        "https://public-api.granola.ai": {
          "allowlist": [
            {
              "methods": [
                "GET",
                "HEAD"
              ],
              "paths": [
                "/v1/*"
              ]
            }
          ],
          "headers": {
            "Authorization": {
              "value": "Bearer {{auth.token.token}}"
            }
          }
        }
      },
      "protocol": "http"
    }
  ],
  "schema_version": 1,
  "setup": "The API key stays on this server. Houston reads notes from Granola; your notes stay in Granola."
}
