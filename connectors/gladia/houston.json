{
  "connection_label": [
    {
      "value": "API key"
    }
  ],
  "schema_version": 2,
  "name": "Gladia",
  "verification_key": "1e48e216259bbfcdcd245351d78a94ae6cca578b843bc7a3c5498cc1baafa929",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "auth": {
    "api_key": {
      "type": "manual",
      "label": "API key",
      "config": {
        "token": {
          "type": "secret",
          "label": "API key",
          "description": "Create a key in the Gladia dashboard under API keys. Gladia bills every transcription to the account that owns the key.",
          "required": true
        }
      }
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "api.gladia.io"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/v2/transcription",
          "/v2/transcription/{id}",
          "/v2/transcription/{id}/file"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "x-gladia-key": "{{auth.api_key.token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.gladia.io"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/v2/upload",
          "/v2/transcription"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "x-gladia-key": "{{auth.api_key.token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.gladia.io"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/v2/transcription/{id}"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "x-gladia-key": "{{auth.api_key.token}}"
          }
        }
      }
    }
  ]
}
