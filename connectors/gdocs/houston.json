{
  "connection_label": [
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "select": "/email"
    }
  ],
  "schema_version": 2,
  "name": "Google Docs",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Google",
      "brand": "google",
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "S256",
      "require_refresh": true,
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "scopes": [
        {
          "values": [
            "https://www.googleapis.com/auth/userinfo.email"
          ]
        },
        {
          "if": "{{ is access.data \"read\" }}",
          "values": [
            "https://www.googleapis.com/auth/documents.readonly"
          ]
        },
        {
          "if": "{{ is access.data \"write\" }}",
          "values": [
            "https://www.googleapis.com/auth/documents"
          ]
        }
      ],
      "account": {
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email"
      }
    }
  },
  "publisher": {
    "client_id": {
      "type": "string",
      "label": "Google OAuth client ID",
      "required": true,
      "order": 1
    },
    "client_secret": {
      "type": "secret",
      "label": "Google OAuth client secret",
      "required": true,
      "order": 2
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "docs.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/v1/documents/{documentId}"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "docs.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/v1/documents",
          "/v1/documents/{documentId}:batchUpdate"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    }
  ]
}
