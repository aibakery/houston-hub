									"BOOKING_RESCHEDULED",
									"BOOKING_REQUESTED",
									"BOOKING_CANCELLED",
									"BOOKING_REJECTED",
									"BOOKING_SEAT_REJECTED",
									"BOOKING_NO_SHOW_UPDATED",
									"BOOKING_LOCATION_UPDATED",
