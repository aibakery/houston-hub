							"type": "string"
						},
						"title": {
							"example": "Learn the secrets of masterchief!",
							"type": "string"
						},
						"useDestinationCalendarEmail": {
							"type": "boolean"
						},
						"useIsolatedAvailability": {
							"default": false,
							"description": "When true, only this event type's own Cal.com bookings block the slot. The availability schedule and connected calendars still apply. Same as \"Consider only this booking link's bookings\" in the web app. Requires an organization with at least 15 members.",
							"type": "boolean"
						},
						"weekStart": {
							"description": "Day the booking page calendar starts the week on. Overrides the host's account setting for this event type only. Omit or set to null to inherit the account setting.",
