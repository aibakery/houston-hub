	"createEventTypeWebhook": {
		"inputSchema": {
			"$defs": {
				"WebhookCustomHeaderInput": {
					"properties": {
						"name": {
							"description": "HTTP header name, at most 256 characters. Names starting with `X-Cal-` are reserved for Cal.com's own headers. Blocked names: host, content-length, transfer-encoding, connection, keep-alive, upgrade, trailer, te, proxy-authorization.",
							"example": "Authorization",
							"type": "string"
						},
						"value": {
							"description": "HTTP header value. Omit (or send the redacted `\"***\"`) on update to keep the stored value, as long as `subscriberUrl` stays the same: stored values are never sent to a new URL. Values are stored encrypted and are always redacted as `\"***\"` on read.",
							"example": "Bearer crsr_xxxxxxxxxxxxx",
							"type": "string"
						}
					},
					"required": [
						"name"
					],
					"type": "object"
				}
			},
			"allOf": [
				{
					"properties": {
						"active": {
							"type": "boolean"
						},
						"customHeaders": {
							"description": "Static HTTP headers sent on every webhook delivery (e.g. Authorization). Max 10 headers, values up to 4 KiB, stored encrypted and redacted on read. Changing `subscriberUrl` drops the stored values unless you send them again. An instance without the webhook header keyring (`CALCOM_KEYRING_WEBHOOK_HEADERS`) answers 400 to any request that sends headers.",
							"items": {
								"$ref": "#/$defs/WebhookCustomHeaderInput"
							},
							"type": "array"
						},
						"payloadTemplate": {
							"description": "The template of the payload that will be sent to the subscriberUrl, check cal.com/docs/core-features/webhooks for more information",
							"example": "{\"content\":\"A new event has been scheduled\",\"type\":\"{{type}}\",\"name\":\"{{title}}\",\"organizer\":\"{{organizer.name}}\",\"booker\":\"{{attendees.0.name}}\"}",
							"type": "string"
						},
						"secret": {
							"type": "string"
						},
						"subscriberUrl": {
							"type": "string"
						},
						"time": {
							"description": "How long after the booking start time the no-show triggers are evaluated. Required, together with timeUnit, when subscribing to AFTER_HOSTS_CAL_VIDEO_NO_SHOW or AFTER_GUESTS_CAL_VIDEO_NO_SHOW",
							"example": 5,
							"minimum": 1,
							"type": "number"
						},
						"timeUnit": {
							"description": "The unit of the no-show time value",
							"enum": [
								"DAY",
								"HOUR",
								"MINUTE"
							],
							"example": "MINUTE",
							"type": "string"
						},
						"triggers": {
							"example": [
								"BOOKING_CREATED",
								"BOOKING_RESCHEDULED",
								"BOOKING_CANCELLED",
								"BOOKING_CONFIRMED",
								"BOOKING_REJECTED",
								"BOOKING_SEAT_REJECTED",
								"BOOKING_COMPLETED",
								"BOOKING_NO_SHOW",
								"BOOKING_REOPENED"
							],
							"items": {
								"enum": [
									"BOOKING_CREATED",
									"BOOKING_PAYMENT_INITIATED",
									"BOOKING_PAID",
									"BOOKING_RESCHEDULED",
									"BOOKING_REQUESTED",
									"BOOKING_CANCELLED",
									"BOOKING_REJECTED",
									"BOOKING_SEAT_REJECTED",
									"BOOKING_NO_SHOW_UPDATED",
									"BOOKING_LOCATION_UPDATED",
									"BOOKING_TITLE_UPDATED",
									"BOOKING_REASSIGNED",
									"BOOKING_SEAT_ACCEPTED",
									"FORM_SUBMITTED",
									"MEETING_ENDED",
									"MEETING_STARTED",
									"RECORDING_READY",
									"INSTANT_MEETING",
									"INSTANT_MEETING_ACCEPTED",
									"RECORDING_TRANSCRIPTION_GENERATED",
									"OOO_CREATED",
									"AFTER_HOSTS_CAL_VIDEO_NO_SHOW",
									"AFTER_GUESTS_CAL_VIDEO_NO_SHOW",
									"FORM_SUBMITTED_NO_EVENT",
									"ROUTING_FORM_FALLBACK_HIT",
									"DELEGATION_CREDENTIAL_ERROR",
									"WRONG_ASSIGNMENT_REPORT",
									"DELEGATION_CREDENTIAL_SECRET_ROTATION_FAILED",
									"DELEGATION_CREDENTIAL_ROTATION_REQUIRED",
									"DELEGATION_CREDENTIAL_SECRET_ROTATED",
									"CALENDAR_ENTRY_REJECTED"
								],
								"type": "string"
							},
							"type": "array"
						},
						"version": {
							"description": "The payload format version of the webhook. Version 2026-07-27 adds generated ICS calendar content (`attendeeIcsContent`, `organizerIcsContent`) to BOOKING_CREATED, BOOKING_RESCHEDULED, BOOKING_CANCELLED, BOOKING_SEAT_ACCEPTED, and BOOKING_PAID (when the payment accepted the booking) payloads. Every version's builder-produced payload carries a `payload.platformOAuthClientId` field naming the owning platform OAuth client (`null` for non-platform events; for the flat-delivered MEETING_STARTED/MEETING_ENDED bodies the field appears at the top level of the body). Zapier deliveries, custom payload templates that do not reference the field, the `AFTER_HOSTS_CAL_VIDEO_NO_SHOW` / `AFTER_GUESTS_CAL_VIDEO_NO_SHOW` bodies (delivered verbatim from the fire-time blob, never built) and the legacy `FORM_SUBMITTED_NO_EVENT` fallback delivery omit it.",
							"enum": [
								"2021-10-20",
								"2026-07-27"
							],
							"example": "2021-10-20",
							"type": "string"
						}
					},
					"required": [
						"active",
						"subscriberUrl",
						"triggers"
					],
					"type": "object"
				}
			],
			"examples": [
				{
					"active": true,
					"eventTypeId": 123,
					"subscriberUrl": "https://example.com/cal-webhook",
					"triggers": [
						"BOOKING_CREATED",
						"BOOKING_CANCELLED"
					]
				}
			],
			"properties": {
				"eventTypeId": {
					"anyOf": [
						{
							"maximum": 9007199254740991,
							"minimum": 0,
							"type": "integer"
						},
						{
							"minLength": 1,
							"pattern": "^[A-Za-z0-9_-]+$",
							"type": "string"
						}
					]
				}
			},
			"required": [
				"eventTypeId"
			],
			"type": "object"
		},
		"outputSchema": {
			"properties": {
				"status": {
					"const": "success"
				}
			},
			"required": [
				"status"
			],
			"type": "object"
		}
	},
