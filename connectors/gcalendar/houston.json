{
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect account",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "openid",
            "email",
            "https://www.googleapis.com/auth/calendar.readonly"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "openid",
            "email",
            "https://www.googleapis.com/auth/calendar"
          ]
        }
      ],
      "token_url": "https://oauth2.googleapis.com/token",
      "type": "oauth2"
    }
  },
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    }
  },
  "description": "Read-only or read-write access to Google Calendar.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Google Calendar",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "GET",
          "HEAD",
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/calendar/*"
        ],
        "protocol": "http"
      }
    }
  ],
  "publisher": {
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "schema_version": 1,
  "setup": "Houston will ask Google for permission, then keep the token on this server. Your events stay in Google."
}
