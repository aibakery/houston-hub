{
  "schema_version": 1,
  "name": "IMAP",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    },
    "host": {
      "label": "IMAP server",
      "order": 2,
      "required": true,
      "type": "string"
    },
    "port": {
      "default": 993,
      "label": "Port",
      "maximum": 65535,
      "minimum": 1,
      "order": 3,
      "type": "integer"
    },
    "username": {
      "label": "Username",
      "order": 4,
      "required": true,
      "type": "string"
    },
    "password": {
      "label": "Password or app password",
      "order": 5,
      "required": true,
      "type": "secret"
    },
    "tls_mode": {
      "default": "verify-full",
      "description": "How Houston checks who the server is. Every mode encrypts the connection. Use the recommended mode for production data.",
      "label": "TLS mode",
      "options": [
        {
          "label": "Verify certificate and host name (recommended)",
          "value": "verify-full"
        },
        {
          "label": "Verify certificate only: doesn't check the host name",
          "value": "verify-ca"
        },
        {
          "label": "Encrypted, but doesn't check who the server is",
          "value": "require"
        }
      ],
      "order": 6,
      "required": true,
      "type": "string"
    },
    "ca_certificate": {
      "description": "The PEM certificate of the authority that signed your server's certificate, or the server's own self-signed certificate. Required with “Verify certificate only”. With the recommended mode, Houston then trusts only this authority instead of public ones.",
      "format": "pem",
      "label": "CA certificate",
      "max_length": 65536,
      "multiline": true,
      "order": 7,
      "placeholder": "-----BEGIN CERTIFICATE-----",
      "type": "string"
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "imap"
      },
      "action": {
        "connection": {
          "host": "{{config.host}}",
          "port": "{{config.port}}",
          "user": "{{config.username}}",
          "password": "{{config.password}}",
          "tls": {
            "mode": "{{config.tls_mode}}",
            "ca": "{{config.ca_certificate}}"
          }
        }
      }
    }
  ]
}
