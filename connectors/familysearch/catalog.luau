	readGenealogiesPersonMatches = {method = "GET", path = "/platform/genealogies/persons/{pid}/matches", read = true, export = "genealogies.persons.readGenealogiesPersonMatches", ["accept"] = "application/x-gedcomx-atom+json", ["description"] = "The Person Matches by Genealogies Person Id resource defines the set of matches in the system for a person in the user-submitted genealogies.\n\nThe scope of the match results can be limited to a specific collection by using the `collection` query parameter.\n\nCurrently, only the following collections support match results:\n\n| title | identifier | description |\n| --- | --- | --- |\n| FamilySearch Records | `https://familysearch.org/platform/collections/records` (or just \"records\") | The set of FamilySearch records. |\n\nIf no collection is specified, the \"records\" collection will be assumed.", ["doc"] = "https://developers.familysearch.org/main/reference/readgenealogiespersonmatches", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["collection"] = {["location"] = "query", ["schema"] = {["default"] = "records", ["description"] = "The name of the collection in which to find matches (records or tree).", ["type"] = "string"}}, ["confidence"] = {["location"] = "query", ["schema"] = {["description"] = "The minimum level of confidence of the results. The higher the number the higher the confidence desired.", ["maximum"] = 5, ["minimum"] = 1, ["type"] = "string"}}, ["count"] = {["location"] = "query", ["schema"] = {["default"] = "5", ["description"] = "The number of results to provide.", ["maximum"] = 100, ["minimum"] = 1, ["type"] = "string"}}, ["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the genealogies person (from user-submitted genealogies) to match against. To find genealogies person IDs, see Read Genealogies Persons.", ["type"] = "string"}}, ["status"] = {["location"] = "query", ["schema"] = {["description"] = "The match status(es) by which to filter the results.