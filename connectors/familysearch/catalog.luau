	mergePerson = {method = "POST", path = "/platform/tree/persons/{pid}/merges/{dpid}", read = false, export = "tree.merges.mergePerson", ["accept"] = "application/x-fs-v1+json", ["body"] = {["contentType"] = "application/x-fs-v1+json", ["required"] = true, ["schema"] = {["properties"] = {["merges"] = {["description"] = "Array containing exactly one merge specification. See Merge Schema (JSON)", ["items"] = {["properties"] = {["resourcesToCopy"] = {["description"] = "URIs of resources from the duplicate person (dpid) to copy to the survivor (pid).", ["items"] = {["properties"] = {["resource"] = {["description"] = "URI of a resource to copy from duplicate to survivor", ["example"] = "https://familysearch.org/platform/tree/persons/WWWW-XXX/conclusions/12345", ["type"] = "string"}}, ["type"] = "object"}, ["type"] = "array"}, ["resourcesToDelete"] = {["description"] = "URIs of resources on the survivor person (pid) to delete before copying.", ["items"] = {["properties"] = {["resource"] = {["description"] = "URI of a resource to delete from survivor", ["example"] = "https://familysearch.org/platform/tree/persons/KKKK-YYY/conclusions/67890", ["type"] = "string"}}, ["type"] = "object"}, ["type"] = "array"}}, ["type"] = "object"}, ["maxItems"] = 1, ["minItems"] = 1, ["type"] = "array"}}, ["required"] = {"merges"}, ["type"] = "object"}}, ["description"] = "This method performs a person merge as specified by a Person ID (survivor) and Duplicate Person ID along with the list of resources to be merged. All resources from the survivor person that need to be deleted must be specified. All resources that should be copied from the duplicate person to the survivor must be specified. If a resource is copied and a resource of the same type already exists on the survivor then that resource must be deleted from the survivor.", ["doc"] = "https://developers.familysearch.org/main/reference/mergeperson", ["example"] = {["body"] = {["merges"] = {{["resourcesToCopy"] = {{["resource"] = "https: