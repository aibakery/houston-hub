	readPersonPortraits = {method = "GET", path = "/platform/tree/persons/{pid}/portraits", read = true, export = "tree.memories.readPersonPortraits", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a list of portrait descriptions associated with a tree person.", ["doc"] = "https://developers.familysearch.org/main/reference/readpersonportraits", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the person whose portraits are to be retrieved. Can be a person from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}}, ["success"] = {200, 204, 301}},
	readPersonSources = {method = "GET", path = "/platform/tree/persons/{pid}/sources", read = true, export = "tree.sources.readPersonSources", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read all sources associated with a person.", ["doc"] = "https://developers.familysearch.org/main/reference/readpersonsources", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the person whose sources are to be retrieved. Can be a person from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}}, ["success"] = {200, 301}},
	readPersonSpouses = {method = "GET", path = "/platform/tree/persons/{pid}/spouses", read = true, export = "tree.persons.readPersonSpouses", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read the set of spouses for a specific person.", ["doc"] = "https://developers.familysearch.org/main/reference/readpersonspouses", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the person whose families are to be retrieved. Can be a person from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}}, ["success"] = {200, 204}},
	readPersons = {method = "GET", path = "/platform/tree/persons", read = true, export = "tree.persons.readPersons", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a list of persons. Invalid ids will be returned in Warning headers. The maximum number of persons that can be read is 200.", ["doc"] = "https://developers.familysearch.org/main/reference/readpersons", ["example"] = {}, ["params"] = {["pids"] = {["location"] = "query", ["schema"] = {["description"] = "A comma separated list of no more than 200 person ids. Can be persons from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlace = {method = "GET", path = "/platform/places/{pid}", read = true, export = "places.readPlace", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a place. A Place resource represents a logical place and will have one or more Place Descriptions associated with it. For example, the city of Provo exists in the county of Utah, in the state of Utah, in the United States. However, when Provo was first established, the state of Utah did not exist. Utah County existed in the Utah Territory. So, Provo has two Place Descriptions but only one Place resource:\n\n- Provo, Utah, Utah Territory, United States (1850-1896)\n- Provo, Utah, Utah, United States (1896-present)", ["doc"] = "https://developers.familysearch.org/main/reference/readplace", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the place. To find place IDs, see Places Search.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceAttributes = {method = "GET", path = "/platform/places/description/{pdid}/attributes", read = true, export = "places.readPlaceAttributes", ["accept"] = "application/ld+json", ["description"] = "Read attributes of a place description.", ["doc"] = "https://developers.familysearch.org/main/reference/readplaceattributes", ["example"] = {["pdid"] = "4229303"}, ["params"] = {["pdid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the place description. To find place description IDs, see Read Places.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceChildren = {method = "GET", path = "/platform/places/description/{pdid}/children", read = true, export = "places.readPlaceChildren", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read the children of a place. It returns the direct children (those place descriptions that are in the jurisdiction) of a given place description. It is generally used for traversing from parent jurisdiction to child jurisdiction where no additional flexibility is needed or wanted. For example, if there's a need to filter on type, year, etc. this resource should not be used. Using this resource to search for children of a place (`/description/1/children`) will return the same results as searching for everything with the parentId of place \"1\" (`/search?q=+parentId:1`).", ["doc"] = "https://developers.familysearch.org/main/reference/readplacechildren", ["example"] = {["pdid"] = "4229303"}, ["params"] = {["pdid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the place description. To find place description IDs, see Read Places.", ["type"] = "string"}}}, ["success"] = {200, 204}},
	readPlaceDescription = {method = "GET", path = "/platform/places/description/{pdid}", read = true, export = "places.readPlaceDescription", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a place description. A Place Description represents a place in a given time period, within a specific jurisdiction, with a specific official name. Place Description identifiers are in a different namespace than Place identifiers - for example, Place ID 123 is not the same as Place Description ID 123.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacedescription", ["example"] = {["pdid"] = "4229303"}, ["params"] = {["pdid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the place description. To find place description IDs, see Read Places.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceDescriptionWithRelated = {method = "GET", path = "/platform/places/description/{pdid}/related", read = true, export = "places.readPlaceDescriptionWithRelated", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a place description with its related place descriptions. This resource is a representation of the place in a given time period, within a specific jurisdiction, with a specific official name. Place Descriptions have a unique, numeric identifier. The identifiers for the Place Description resource are in a different namespace than the identifier for the Place resource. For example, Place identifier 123 is not the same as Place Description 123. These unique identifiers can be used to associate places with their own data, providing a powerful way to link data together.\n\nThis endpoint returns all of the place descriptions related to the place description requested. Related place descriptions have a type of DELETED, SAME_NAME, SAME_PLACE or ASSOCIATED. ASSOCIATED types can have a sub-type whose values are free-form.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacedescriptionwithrelated", ["example"] = {["pdid"] = "4229303"}, ["params"] = {["deletedSince"] = {["location"] = "query", ["schema"] = {["description"] = "Only return DELETED related place descriptions that were deleted on or after this date.", ["type"] = "string"}}, ["pdid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the place description. To find place description IDs, see Read Places.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceDescriptions = {method = "GET", path = "/platform/places/description", read = true, export = "places.readPlaceDescriptions", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a list of place descriptions.  See the Place Description resource for a definition of a Place Description.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacedescriptions", ["example"] = {["pdids"] = "4229303"}, ["params"] = {["pdids"] = {["location"] = "query", ["required"] = true, ["schema"] = {["description"] = "The ids of the place descriptions to be retrieved. To find place description IDs, see Read Places.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceDescriptionsGroup = {method = "GET", path = "/platform/places/groups/{pgid}", read = true, export = "places.readPlaceDescriptionsGroup", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a place descriptions group. A place descriptions group is an arbitrary grouping of place descriptions or other groups. Partners can use this resource to group place descriptions that are related, such as countries in North America. It doesn't impact the jurisdiction of the contained places. You can group place descriptions into one named resource without changing the jurisdiction of those contained places.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacedescriptionsgroup", ["example"] = {["pgid"] = "15"}, ["params"] = {["pgid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the place descriptions group.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceType = {method = "GET", path = "/platform/places/types/{ptid}", read = true, export = "places.readPlaceType", ["accept"] = "application/ld+json", ["description"] = "Read a place type.  A place type is a type of place, such as a cemetery, city, state, etc. Types have translated names, which is useful for localization purposes.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacetype", ["example"] = {["ptid"] = "LZJW-C31"}, ["params"] = {["ptid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the place type. To find place type IDs, see Read Place Types.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceTypeGroup = {method = "GET", path = "/platform/places/type-groups/{ptgid}", read = true, export = "places.readPlaceTypeGroup", ["accept"] = "application/ld+json", ["description"] = "Read a place type group. A place type group is a collection of related place types that provides convenience when working with types. For example, there are a number of city-like types, such as city, populated place, and capital city. A \"city-like\" type group can be used to include all of them.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacetypegroup", ["example"] = {["ptgid"] = "LZJW-C31"}, ["params"] = {["ptgid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the place type group. To find place type group IDs, see Read Place Type Groups.", ["type"] = "string"}}}, ["success"] = {200}},
	readPlaceTypeGroups = {method = "GET", path = "/platform/places/type-groups", read = true, export = "places.readPlaceTypeGroups", ["accept"] = "application/ld+json", ["description"] = "Read the list of place type groups. A place type group is a collection of related place types that provides convenience when working with types. For example, a \"city-like\" type group includes city, populated place, and capital city types.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacetypegroups", ["example"] = {}, ["params"] = {}, ["success"] = {200}},
	readPlaceTypes = {method = "GET", path = "/platform/places/types", read = true, export = "places.readPlaceTypes", ["accept"] = "application/ld+json", ["description"] = "Read the list of place types. A place type defines a category of place such as cemetery, city, state, etc. Types have translated names for localization purposes.", ["doc"] = "https://developers.familysearch.org/main/reference/readplacetypes", ["example"] = {}, ["params"] = {}, ["success"] = {200}},
	readPlaces = {method = "GET", path = "/platform/places/search", read = true, export = "places.readPlaces", ["accept"] = "application/x-gedcomx-atom+json", ["description"] = "The Places Search query facilitates the interpretation of a place name with a standardized place description. Clients can interpret user-entered place names and associate a standardized place with the name. They can also retrieve specific types of places by including specific name-value pairs within the places query parameter. Please note that all name-value pairs and URLs must adhere to the HTTP specifications. The following name-value pairs are applicable to the places query:\n\nQuery (q) parameter name-value pairs table:\n\n| Name           | Description                                                  |\n| -------------- | ------------------------------------------------------------ |\n| name           | The name of the place. This parameter causes an interpretation of the name to occur, with results ordered in \"best guess first\" order. Supports the '?' and the '*' wildcards, but the wildcard MUST NOT be at beginning of name. Escape wildcard character with backslash '\\' for literal character search. Supports the `~` suffix for application-specific fuzzy search (incompatible with non-escaped wildcards). Wildcards and escaped wildcards on the same query are not supported. Example values: `name:\"New York, New York\"` or `name:england` or `name:\"par*,france\"` |\n| partialName    | The partial name of the place. This parameter is used to search for the \"partial\" name of a place. A partial name search is designed specifically for type-ahead use cases. The treatment of wildcards in a partial name is unspecified. If partialName is used, the name parameter will be ignored. |\n| date           | The date (or date range). Supports the '+' operator to specify a required date (or date range). When there is no '-' operator, the date (or date range) is optional. Implied granularity is in years. See the GEDCOM X [Date Format](https://github.com/FamilySearch/gedcomx/blob/master/specifications/date-format-specification.md#format) for more information. `+date:1800/1900` or `+date:1823` or `date:1723/2000` |\n| typeId         | The place type id. Supports the '+' operator to require the results to conform to the type. Supports the '-' operator to exclude places that conform to the type. Otherwise, the type is optional. For example, if '186' is the type id for cities, to include only cities in your results, enter `+typeId:186`. To exclude cities in your results, enter -typeId:186. Also supports multiple typeIds, such as `+typeId:186` or `+typeId:209`. |\n| typeGroupId    | The place type group id. Supports the '+' operator to require the results to conform to the type group. Supports the '-' operator to exclude places that conform to the type group. Otherwise, the type group is optional. Supports multiple typeGroupIds in the form of +typeGroupId:123 +typeGroupId:456 |\n| parentId       | The parent jurisdiction (as a Place Description identifier) to limit the search results. Supports the '+' operator to require the results to have the parent jurisdiction. Supports the '-' operator to exclude places that are within the parent jurisdiction. Supports the '\\~' suffix for \"any child\", otherwise, implies direct parent. With no '+' or '-' specified, the parent is optional. For example, if the request is +parentId:1\\~ (US), all places within the US is returned. If the request is +parentId:1, only direct parents, like states, are returned. Supports multiple parentIds in the form of `+parentId:1~` or `-parentId:32`. |\n| latitude       | The latitude of a centroid to search near.                   |\n| longitude      | The longitude of a centroid to search near.                  |\n| distance       | The distance from the centroid to search near. Units can be specified in Kilometers (K) or Miles (M) by appending the appropriate letter to the value. For example, `distance:45K`. Default unit is miles. |\n| placeHint      | A place to use as a hint for finding the proper Place Representation. The assumption is that the hint specified has some form of relationship to the Place Representation being looked for, such as a parent or child jurisdiction, a nearby place, etc. The value of this parameter can be a comma-delimited list of Place Rep IDs or a semi-colon-delimited list of names. |\n", ["doc"] = "https://developers.familysearch.org/main/reference/readplaces", ["example"] = {["q"] = "name:Paris parentId:329~"}, ["params"] = {["count"] = {["location"] = "query", ["schema"] = {["description"] = "The number of search results per page.", ["type"] = "string"}}, ["q"] = {["location"] = "query", ["required"] = true, ["schema"] = {["description"] = "The query parameter that describes the search criteria. The parameter consists of name(s) and value(s) separated by a colon (:) and each name-value pair is separated by a white space ( ). By default, values are exact. For non exact matches, append a tilde (\\~) at the end of the value, such as name:Baden\\~", ["type"] = "string"}}, ["start"] = {["location"] = "query", ["schema"] = {["description"] = "The index of the first search result for this page of results.", ["type"] = "string"}}}, ["success"] = {200, 204}},
	readPreferredSpouseRelationship = {method = "GET", path = "/platform/tree/users/{uid}/preferred-spouse-relationships/{pid}", read = true, export = "tree.preferences.readPreferredSpouseRelationship", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read the preferred spouse relationship for the given user and tree person. The preferred spouse relationship affects only the user that creates it.", ["doc"] = "https://developers.familysearch.org/main/reference/readpreferredspouserelationship", ["example"] = {["pid"] = "LZJW-C31", ["uid"] = "LZJW-C31"}, ["params"] = {["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the tree person. Can be a person from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}, ["uid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the authenticated user. To find user IDs, see Read Current User.", ["type"] = "string"}}}, ["success"] = {204, 301, 303}},
	readSourceDescription = {method = "GET", path = "/platform/sources/descriptions/{sdid}", read = true, export = "sources.descriptions.readSourceDescription", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a source description. The Source Description resource gets a user's source description.\n\nThe FamilySearch implementation of the Source Description resource does not support all properties of a source description as defined by GEDCOM X. Support is limited to the following:\n\n| Property | Description |\n| --- | --- |\n| id | A local identifier for the source description. |\n| about | URI to the resource being described, if any. |\n| title | Label, title, or other name to display to the user for the source. |\n| citation | The citation for the source. FamilySearch only supports the value of the citation and not any template or associated citation fields. |\n| notes | Notes about the source provided by a user. |", ["doc"] = "https://developers.familysearch.org/main/reference/readsourcedescription", ["example"] = {["sdid"] = "SS2N-XJW"}, ["params"] = {["sdid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the source description. To find source description IDs, see Read User Source Descriptions, or Create Source Description to create a new source description.", ["type"] = "string"}}}, ["success"] = {200, 301, 307}},
	readSourceDescriptionHead = {method = "HEAD", path = "/platform/sources/descriptions/{sdid}", read = true, export = "sources.descriptions.readSourceDescriptionHead", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read the headers for a source description.", ["doc"] = "https://developers.familysearch.org/main/reference/readsourcedescriptionhead", ["example"] = {["sdid"] = "SS2N-XJW"}, ["params"] = {["sdid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the source description. To find source description IDs, see Read User Source Descriptions, or Create Source Description to create a new source description.", ["type"] = "string"}}}, ["success"] = {200}},
	readSourceDescriptions = {method = "GET", path = "/platform/sources/descriptions", read = true, export = "sources.descriptions.readSourceDescriptions", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a list of all user-defined source descriptions.\n\nThe FamilySearch implementation of the Source Description resource does not support all properties of a source description as defined by GEDCOM X. For more information, see the [Source Description Resource](Source_Description_resource).", ["doc"] = "https://developers.familysearch.org/main/reference/readsourcedescriptions", ["example"] = {}, ["params"] = {["sdids"] = {["location"] = "query", ["schema"] = {["description"] = "A comma and/or space separated list of source description IDs (maximum of 30). To find source description IDs, see Read User Source Descriptions, or Create Source Description to create a new source description.", ["type"] = "string"}}}, ["success"] = {200, 204, 303}},
	readSourceFolders = {method = "GET", path = "/platform/sources/collections", read = true, export = "sources.folders.readSourceFolders", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read the collections defined by the current user.", ["doc"] = "https://developers.familysearch.org/main/reference/readsourcefolders", ["example"] = {}, ["params"] = {}, ["success"] = {307}},
	readSourceReferences = {method = "GET", path = "/platform/tree/source-references", read = true, export = "tree.sources.readSourceReferences", ["accept"] = "application/x-fs-v1+json", ["description"] = "The Source References Query returns a collection of persons and relationships that reference a specific source description or a specific source, depending on which parameter is used. To see a list of all persons and relationships attached to a source such as a census record, use the `source` parameter. To see a list of all persons and relationships attached to a source description, use the `description` parameter.", ["doc"] = "https://developers.familysearch.org/main/reference/readsourcereferences", ["example"] = {}, ["params"] = {["description"] = {["location"] = "query", ["schema"] = {["description"] = "The ID of the source description. Either this parameter or `source` must be provided. To find source description IDs, see Read User Source Descriptions, or Create Source Description to create a new source description.", ["type"] = "string"}}, ["source"] = {["location"] = "query", ["schema"] = {["description"] = "The URI of the source. Either this parameter or `description` must be provided.", ["type"] = "string"}}}, ["success"] = {200, 204}},
	readTree = {method = "GET", path = "/platform/trees/{tid}", read = true, export = "tree.trees.readTree", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a user tree specified by the tree id in the path.", ["doc"] = "https://developers.familysearch.org/main/reference/readtree", ["example"] = {["tid"] = "LZJW-C31"}, ["params"] = {["tid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the user tree to retrieve. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"] = "string"}}}, ["success"] = {200}},
	readTreeChanges = {method = "GET", path = "/platform/trees/{tid}/changes", read = true, export = "tree.trees.readTreeChanges", ["accept"] = "application/x-gedcomx-atom+json", ["description"] = "This operation retrieves the list of changes in a user tree. The list is returned as a Feed of Entry elements. Each Entry contains a ChangeInfo element.", ["doc"] = "https://developers.familysearch.org/main/reference/readtreechanges", ["example"] = {["tid"] = "LZJW-C31"}, ["params"] = {["from"] = {["location"] = "query", ["schema"] = {["description"] = "Token specifying the page to be retrieved. A next link with a page token is returned in the response when there are more changes available.", ["type"] = "string"}}, ["tid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the tree whose change history is to be retrieved. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"] = "string"}}, ["timestamp"] = {["location"] = "query", ["schema"] = {["description"] = "Unix timestamp; see https://en.wikipedia.org/wiki/Unix_time. Changes with a timestamp >= to this value will be retrieved. This parameter is ignored if a pageToken parameter is provided.", ["type"] = "string"}}}, ["success"] = {200, 204}},
	readTreeMatches = {method = "GET", path = "/platform/trees/{tid}/matches", read = true, export = "tree.trees.readTreeMatches", ["accept"] = "application/x-gedcomx-atom+json", ["description"] = "Returns the matches for a user tree. Allows filtering on the request to focus on the “best” historical record hints, person hints to other user trees or to the Shared Family Tree.", ["doc"] = "https://developers.familysearch.org/main/reference/readtreematches", ["example"] = {["tid"] = "LZJW-C31"}, ["params"] = {["candidateTreeId"] = {["location"] = "query", ["schema"] = {["description"] = "Use candidateTreeId to get Person matches within a specific user tree. If present, collection=user_trees must be used. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"] = "string"}}, ["collection"] = {["location"] = "query", ["schema"] = {["description"] = "The collection specifies the category of hints to get. It specifies the system to retrieve matches from. Default is 'records'.\n\n- `tree` returns person matches within the Family Tree.\n- `records` returns historical record hints for the specified treeId.\n- `user_trees` returns person matches within user trees.\n", ["type"] = "string"}}, ["confidence"] = {["location"] = "query", ["schema"] = {["description"] = "The level of confidence of the results. The higher the number, the higher the confidence desired.", ["example"] = 1, ["maximum"] = 5, ["minimum"] = 1, ["type"] = "integer"}}, ["count"] = {["location"] = "query", ["schema"] = {["description"] = "The number of matches to return. Minimum is 1, maximum is 100. Default is 5.", ["type"] = "string"}}, ["from"] = {["location"] = "query", ["schema"] = {["description"] = "Page token specifying the page to be retrieved. A next link with a page token is returned in the response when there are more matches available.", ["type"] = "string"}}, ["sortBy"] = {["location"] = "query", ["schema"] = {["description"] = "Sort order for the matches. Accepted values are 'score' and 'recent'. Default is 'score'.\n\n- `score`: returns hints by score, with highest scoring hints first.\n- `recent`: returns hints by date, with the most recent hints first.\n", ["type"] = "string"}}, ["status"] = {["location"] = "query", ["schema"] = {["description"] = "The status of the matches to retrieve. Default is 'pending'. Multiple status flags may be set in the same request.\n\n- `pending` returns hints that have not been accepted or rejected. These are actionable hints for the specified id.\n- `accepted` returns hints that have been accepted for the specified id.\n- `rejected` returns hints that have been rejected for the specified id.\n", ["type"] = "string"}}, ["tid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the tree whose matches are to be retrieved. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"] = "string"}}}, ["success"] = {200, 204}},
	readTreePersonMatches = {method = "GET", path = "/platform/tree/persons/{pid}/matches", read = true, export = "tree.search.readTreePersonMatches", ["accept"] = "application/x-gedcomx-atom+json", ["description"] = "The Match by Tree Person Id endpoint defines the set of matches in the system for a person in the Family Tree.\n\nThe scope of the match results can be limited to a specific collection using the `collection` query parameter.\n\nCurrently, only the following collections support match results:\n\n| title | identifier | description |\n| --- | --- | --- |\n| FamilySearch Tree | `https://familysearch.org/platform/collections/tree` (or just \"tree\") | The set of matches (possible duplicates) in the FamilySearch tree. |\n| FamilySearch Records | `https://familysearch.org/platform/collections/records` (or just \"records\") | The set of matches in the FamilySearch records. |\n| FamilySearch User Trees | `https://familysearch.org/platform/collections/cet` (or just \"cet\") | The set of matches in the FamilySearch user trees. |\n\nIf no collection is specified, the request will be interpreted as matches in the FamilySearch tree (possible duplicates) Family Tree.\n\nEach match has a \"status\" that indicates it to be in one of the following states:\n\n| name | identifier | description |\n| --- | --- | --- |\n| Pending | `http://familysearch.org/v1/Pending` | The match has neither been accepted nor rejected. |\n| Accepted | `http://familysearch.org/v1/Accepted` | The match has been accepted as valid. |\n| Rejected | `http://familysearch.org/v1/Rejected` | The match has been rejected as invalid. |\n\nMatch results can be filtered using the `status` query parameter.\n", ["doc"] = "https://developers.familysearch.org/main/reference/readtreepersonmatches", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["collection"] = {["location"] = "query", ["schema"] = {["default"] = "tree", ["description"] = "The name of the collection in which to find matches. The possible values are tree, user_trees, or records. Note: 'cet' is deprecated, use 'user_trees' instead.", ["enum"] = {"tree", "user_trees", "records", "cet"}, ["type"] = "string"}}, ["confidence"] = {["location"] = "query", ["schema"] = {["description"] = "The level of confidence of the results. The higher the number, the higher the confidence desired.", ["maximum"] = 5, ["minimum"] = 1, ["type"] = "integer"}}, ["count"] = {["location"] = "query", ["schema"] = {["default"] = 5, ["description"] = "The number of results to provide.", ["maximum"] = 100, ["minimum"] = 1, ["type"] = "integer"}}, ["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the person whose matches are requested. Can be a person from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}, ["status"] = {["location"] = "query", ["schema"] = {["description"] = "The match status(es) by which to filter the results. For tree collection matches the default is pending and accepted. For record collection matches the default is pending matches.", ["type"] = "string"}}, ["treeId"] = {["location"] = "query", ["schema"] = {["description"] = "The tree id of the user tree to match against. For use with the user tree collection only. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"] = "string"}}}, ["success"] = {200, 204, 301}},
	readTreePersonMatchesHeaders = {method = "HEAD", path = "/platform/tree/persons/{pid}/matches", read = true, export = "tree.search.readTreePersonMatchesHeaders", ["accept"] = "application/x-fs-v1+json", ["description"] = "Determine if there are matches for the given person id.", ["doc"] = "https://developers.familysearch.org/main/reference/readtreepersonmatchesheaders", ["example"] = {["pid"] = "LZJW-C31"}, ["params"] = {["collection"] = {["location"] = "query", ["schema"] = {["default"] = "tree", ["description"] = "The name of the collection in which to find matches. The possible values are tree, user_trees, or records. Note: 'cet' is deprecated, use 'user_trees' instead.", ["enum"] = {"tree", "user_trees", "records", "cet"}, ["type"] = "string"}}, ["confidence"] = {["location"] = "query", ["schema"] = {["description"] = "The level of confidence of the results. The higher the number, the higher the confidence desired.", ["maximum"] = 5, ["minimum"] = 1, ["type"] = "integer"}}, ["count"] = {["location"] = "query", ["schema"] = {["default"] = 5, ["description"] = "The number of results to provide.", ["maximum"] = 100, ["minimum"] = 1, ["type"] = "integer"}}, ["pid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The ID of the person whose matches are requested. Can be a person from the main FamilySearch tree or from a user tree. To find an example person ID, see Search Tree Persons.", ["type"] = "string"}}, ["status"] = {["location"] = "query", ["schema"] = {["description"] = "The match status(es) by which to filter the results. For tree collection matches the default is pending and accepted. For record collection matches the default is pending matches.", ["type"] = "string"}}, ["treeId"] = {["location"] = "query", ["schema"] = {["description"] = "The tree id of the user tree to match against. For use with the user tree collection only. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"