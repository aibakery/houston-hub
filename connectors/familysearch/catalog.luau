	performPersonMatchesByExample = {method = "POST", path = "/platform/tree/matches", read = true, export = "tree.search.performPersonMatchesByExample", ["accept"] = "application/x-gedcomx-atom+json", ["body"] = {["contentType"] = "application/x-fs-v1+json", ["required"] = false, ["schema"] = {["properties"] = {["description"] = {["description"] = "Reference to the source description ID (e.g., '#sd1')", ["example"] = "#sd1", ["type"] = "string"}, ["persons"] = {["description"] = "Array of persons to match. Must include at least one primary person with an ID. See Person Schema (JSON)", ["items"] = {["properties"] = {["facts"] = {["description"] = "Array of facts (events) for the person", ["items"] = {["properties"] = {["date"] = {["description"] = "The date of the fact", ["properties"] = {["original"] = {["description"] = "The date in original form. Can be specific (20 July 1946), partial (May 1836 or just 1836), approximate (about 1793) or a range (1898-1903).", ["example"] = "30 January 1880", ["type"] = "string"}}, ["type"] = "object"}, ["place"] = {["description"] = "The place of the fact", ["properties"] = {["original"] = {["description"] = "The place in original form", ["example"] = "Orderville, UT", ["type"] = "string"}}, ["type"] = "object"}, ["type"] = {["description"] = "The fact type URI (e.g., Birth, Death, Marriage)", ["example"] = "http://gedcomx.org/Birth", ["type"] = "string"}}, ["type"] = "object"}, ["type"] = "array"}, ["gender"] = {["description"] = "The gender of the person", ["properties"] = {["type"] = {["description"] = "The gender type URI", ["example"] = "http://gedcomx.org/Male", ["type"] = "string"}}, ["type"] = "object"}, ["id"] = {["description"] = "The person identifier. Use descriptive IDs like 'primaryPerson', 'father1', 'mother1', etc.", ["example"] = "primaryPerson", ["type"] = "string"}, ["names"] = {["description"] = "Array of names for the person", ["items"] = {["properties"] = {["nameForms"] = {["description"] = "Array of name forms", ["items"] = {["properties"] = {["fullText"] = {["description"] = "The full text of the name", ["example"] = "Israel Heaton", ["type"] = "string"}}, ["type"] = "object"}, ["type"] = "array"}, ["type"] = {["description"] = "The name type URI", ["example"] = "http://gedcomx.org/BirthName", ["type"] = "string"}}, ["type"] = "object"}, ["type"] = "array"}}, ["required"] = {"id"}, ["type"] = "object"}, ["minItems"] = 1, ["type"] = "array"}, ["relationships"] = {["description"] = "Array of relationships between persons. Persons not specified in a relationship (other than the primary person) will be ignored when matching. See Relationship Schema (JSON)", ["items"] = {["properties"] = {["person1"] = {["description"] = "Reference to the first person in the relationship", ["properties"] = {["resource"] = {["description"] = "URI reference to a person ID (e.g., '#father1')", ["example"] = "#father1", ["type"] = "string"}}, ["required"] = {"resource"}, ["type"] = "object"}, ["person2"] = {["description"] = "Reference to the second person in the relationship", ["properties"] = {["resource"] = {["description"] = "URI reference to a person ID (e.g., '#primaryPerson')", ["example"] = "#primaryPerson", ["type"] = "string"}}, ["required"] = {"resource"}, ["type"] = "object"}, ["type"] = {["description"] = "The relationship type URI", ["example"] = "http://gedcomx.org/ParentChild", ["type"] = "string"}}, ["required"] = {"type", "person1", "person2"}, ["type"] = "object"}, ["type"] = "array"}, ["sourceDescriptions"] = {["description"] = "Array of source descriptions. Must include a main source description that points to the primary person. See SourceDescription Schema (JSON)", ["items"] = {["properties"] = {["about"] = {["description"] = "Reference to the primary person ID via an anchor tag", ["example"] = "#primaryPerson", ["type"] = "string"}, ["id"] = {["description"] = "The source description identifier", ["example"] = "sd1", ["type"] = "string"}, ["identifiers"] = {["description"] = "Optional map of identifiers for the source description", ["type"] = "object"}}, ["required"] = {"id", "about"}, ["type"] = "object"}, ["minItems"] = 1, ["type"] = "array"}}, ["required"] = {"description", "persons", "sourceDescriptions"}, ["type"] = "object"}}, ["description"] = "The Person Matches by Example resource returns a list of possible FamilySearch tree persons that match a person described by a GEDCOM X document\ncontaining person details (POST). This resource is particularly useful for matching a person in an external tree to a person in the FamilySearch tree. The\nMatch by Tree Person Id resource should be used to find matches (possible duplicates) for a specific person already in the FamilySearch tree.\n \nEach entry in the match results may contain content of the GEDCOM X media type that provides data about\nthe results, e.g., persons and relationships.\n \nPerson Matches are non-exact. The match algorithm will take into account all the information given about the person (and the person's parents,\nchildren and spouses, if included) and return matches, each having a likelihood of the match being the same person that was specified in the request.\nBecause the match algorithm is non-exact, a returned match may have information that does not exactly match the information\nspecified in the request. The likelihood is contained in the ResultConfidence field of each Entry (match result).\n \nDates can be specific (20 July 1946), partial (May 1836 or just 1836), approximate (about 1793) or a range (1898-1903).\n \n\n\nThe POST body must contain a valid GEDCOM X JSON or XML block.  The following elements of the GEDCOM X are required:\n\n  \n    Primary Person\n    There must be a primary person and the primary person must have an id (such as \"primaryPerson\")\n  \n  \n    Main Source Description\n    There must be a main source description in the GEDCOM X document that points to the primary person (see Main sourceDescription.about below)\n  \n  \n    Main sourceDescription.about\n    The main source description's about attribute must point to the primary person via an anchor tag (i.e. about=\"#primaryPerson\")\n  \n\n\nNote: For more accurate results, the GEDCOM X POST body may (and should whenever possible) contain the main person's parents, spouses, and\nchildren. All the persons in the GEDCOM X must have IDs so that relationships can be defined between the persons. Persons not specified in a\nrelationship (other than the primary person) will be ignored when matching. The person IDs can be of any format. IDs such as \"primaryPerson\", \"mother1\",\n\"child1\" etc. are acceptable and more intuitive for human understanding.\n", ["doc"] = "https://developers.familysearch.org/main/reference/performpersonmatchesbyexample", ["example"] = {["body"] = {["description"] = "#sd1", ["persons"] = {{["facts"] = {{["date"] = {["original"] = "30 January 1880"}, ["place"] = {["original"] = "Orderville, UT"}, ["type"] = "http://gedcomx.org/Birth"}}, ["gender"] = {["type"] = "http://gedcomx.org/Male"}, ["id"] = "primaryPerson", ["names"] = {{["nameForms"] = {{["fullText"] = "Israel Heaton"}}, ["type"] = "http://gedcomx.org/BirthName"}}}}, ["relationships"] = {{["person1"] = {["resource"] = "#father1"}, ["person2"] = {["resource"] = "#primaryPerson"}, ["type"] = "http://gedcomx.org/ParentChild"}}, ["sourceDescriptions"] = {{["about"] = "#primaryPerson", ["id"] = "sd1", ["identifiers"] = {}}}}}, ["params"] = {["collection"] = {["location"] = "query", ["schema"] = {["default"] = "tree", ["description"] = "The name of the collection in which to find matches. The possible values are 'tree' or 'user_trees'. Note: 'cet' is deprecated, use 'user_trees' instead.", ["enum"] = {"tree", "user_trees", "cet"}, ["type"] = "string"}}, ["confidence"] = {["location"] = "query", ["schema"] = {["description"] = "The level of confidence of the results. The higher the number the higher the confidence.", ["maximum"] = 5, ["minimum"] = 1, ["type"] = "integer"}}, ["count"] = {["location"] = "query", ["schema"] = {["default"] = 5, ["description"] = "The number of results to provide.", ["maximum"] = 100, ["minimum"] = 1, ["type"] = "integer"}}, ["treeId"] = {["location"] = "query", ["schema"] = {["description"] = "The tree id of the user tree to match against. For use only with user trees. To match against all user trees do not pass in. To find user tree IDs, see Read User's Groups, or Create Tree to create a new user tree.", ["type"] = "string"}}}, ["success"] = {200, 204}},
