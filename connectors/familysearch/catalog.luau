	readUserMemories = {method = "GET", path = "/platform/memories/users/{uid}/memories", read = true, export = "memories.readUserMemories", ["accept"] = "application/x-fs-v1+json", ["description"] = "Read a user's memories. The user memories query provides a (paged) list of artifacts of memories that belong to a specific user. This allows users to get a list of all memories that have been uploaded by the current user. To do this, make a request to the [User Memories resource](https://developers.familysearch.org/familysearch1/reference/readusermemories-1#/) with the `Accept` header set to `application/x-fs-v1+json`.", ["doc"] = "https://developers.familysearch.org/main/reference/readusermemories", ["example"] = {["start"] = 0, ["uid"] = "LZJW-C31"}, ["params"] = {["count"] = {["location"] = "query", ["schema"] = {["description"] = "The maximum number of artifacts belonging to this user to return. If not specified or a bad value, all memories will be returned.", ["minimum"] = 1, ["type"] = "integer"}}, ["start"] = {["location"] = "query", ["required"] = true, ["schema"] = {["default"] = 0, ["description"] = "The index (zero-based) of the first artifact belonging to this user to be returned.", ["minimum"] = 0, ["type"] = "integer"}}, ["uid"] = {["location"] = "path", ["required"] = true, ["schema"] = {["description"] = "The id of the user. To find user IDs, see Read Current User.", ["type"] = "string"}}}, ["success"] = {200, 204}},
