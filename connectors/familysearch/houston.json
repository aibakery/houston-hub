  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Accept": {
            "value": "application/x-fs-v1+json"
          },
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/users/0/id",
        "method": "GET",
        "url": "https://api.familysearch.org/platform/users/current"
      },
      "authorize_url": "https://ident.familysearch.org/cis-web/oauth2/v3/authorization",
      "client_auth": "none",
      "client_id": "{{config.client_id}}",
      "if": "{{ is config.environment \"production\" }}",
      "label": "Sign in with FamilySearch",
      "order": 1,
      "pkce": "S256",
      "token_url": "https://ident.familysearch.org/cis-web/oauth2/v3/token",
      "type": "oauth2"
    },
    "oauth_beta": {
      "account": {
        "headers": {
          "Accept": {
            "value": "application/x-fs-v1+json"
          },
          "Authorization": {
            "value": "Bearer {{auth.oauth_beta.access_token}}"
          }
        },
        "label": "/users/0/id",
        "method": "GET",
        "url": "https://apibeta.familysearch.org/platform/users/current"
      },
      "authorize_url": "https://identbeta.familysearch.org/cis-web/oauth2/v3/authorization",
      "client_auth": "none",
      "client_id": "{{config.client_id}}",
