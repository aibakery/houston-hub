      "order": 1,
      "pkce": "S256",
      "token_url": "https://identbeta.familysearch.org/cis-web/oauth2/v3/token",
      "type": "oauth2"
    },
    "token": {
      "config": {
        "token": {
          "label": "Access token",
          "required": true,
          "type": "secret"
        }
      },
      "description": "A short-lived token obtained through FamilySearch OAuth, not your app key or password.",
      "label": "Existing access token",
      "order": 2,
      "type": "manual"
    }
  },
  "config": {
    "client_id": {
      "description": "Your public OAuth application key, enabled for the selected environment. Register the displayed callback URI with FamilySearch before signing in.",
      "label": "FamilySearch app key",
      "order": 3,
