{
  "schema_version": 1,
  "name": "AssessFirst",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.png",
  "config": {
    "access": {
      "default": "read-only",
      "description": "Completion status only shows agents which assessments each candidate has finished, with names and emails; Houston refuses every request for scores, reports and other results on that level, and every change. Houston sends no changes on a Read-only connection. The AssessFirst API token itself has full access to your company's AssessFirst data.",
      "label": "Access",
      "options": [
        {
          "label": "Completion status only",
          "value": "custom"
        },
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    },
    "api_host": {
      "default": "app.assessfirst.com",
      "description": "Use Test only with a token generated on simu.assessfirst.com, AssessFirst's test environment.",
      "label": "Environment",
      "options": [
        {
          "label": "Production",
          "value": "app.assessfirst.com"
        },
        {
          "label": "Test",
          "value": "simu.assessfirst.com"
        }
      ],
      "order": 2,
      "type": "string"
    }
  },
  "auth": {
    "token": {
      "config": {
        "token": {
          "label": "API token",
          "max_length": 512,
          "required": true,
          "type": "secret"
        }
      },
      "label": "AssessFirst API token",
      "type": "manual"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "AF-Token": "{{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "{{config.api_host}}"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/betty-V2/candidate/{candidate_uuid}/completion",
          "/betty-V2/candidates",
          "/betty-V2/groups",
          "/betty-V2/groups/{group_uuid}/users",
          "/betty-V2/predictive-models"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "AF-Token": "{{auth.token.token}}"
          }
        }
      },
      "if": "{{ is config.access \"read-only\" }}",
      "match": {
        "host": [
          "{{config.api_host}}"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/betty-V2/benchmarks",
          "/betty-V2/candidate/{candidate_uuid}",
          "/betty-V2/candidate/{candidate_uuid}/adequacies/{pm_uuid}",
          "/betty-V2/candidate/{candidate_uuid}/career/top",
          "/betty-V2/candidate/{candidate_uuid}/init-voice/{pm_uuid}",
          "/betty-V2/candidate/{candidate_uuid}/report/{report_id}",
          "/betty-V2/candidate/{candidate_uuid}/reports",
          "/betty-V2/candidate/{candidate_uuid}/scores",
          "/betty-V2/candidate/{candidate_uuid}/synthesis",
          "/betty-V2/locales",
          "/betty-V2/onepager/candidate/{candidate_uuid}/results",
          "/betty-V2/recruiters",
          "/betty-V2/webhooks"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "AF-Token": "{{auth.token.token}}"
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "{{config.api_host}}"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/betty-V2/benchmarks",
          "/betty-V2/candidate/{candidate_uuid}",
          "/betty-V2/candidate/{candidate_uuid}/adequacies/{pm_uuid}",
          "/betty-V2/candidate/{candidate_uuid}/career/top",
          "/betty-V2/candidate/{candidate_uuid}/init-voice/{pm_uuid}",
          "/betty-V2/candidate/{candidate_uuid}/report/{report_id}",
          "/betty-V2/candidate/{candidate_uuid}/reports",
          "/betty-V2/candidate/{candidate_uuid}/scores",
          "/betty-V2/candidate/{candidate_uuid}/synthesis",
          "/betty-V2/locales",
          "/betty-V2/onepager/candidate/{candidate_uuid}/results",
          "/betty-V2/recruiters",
          "/betty-V2/webhooks"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "AF-Token": "{{auth.token.token}}"
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "{{config.api_host}}"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/betty-V2/candidate",
          "/betty-V2/candidate/send-invitation",
          "/betty-V2/candidate/{candidate_uuid}/init-voice/{pm_uuid}",
          "/betty-V2/groups",
          "/betty-V2/groups/{group_uuid}/user/{user_uuid}",
          "/betty-V2/webhooks"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "AF-Token": "{{auth.token.token}}"
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "{{config.api_host}}"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/betty-V2/groups/{group_uuid}",
          "/betty-V2/groups/{group_uuid}/user/{user_uuid}",
          "/betty-V2/webhooks/{webhook_uuid}"
        ],
        "protocol": "http"
      }
    }
  ]
}
