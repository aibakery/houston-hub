	"updateDraft": {
		"$defs": {
			"InboxDraftAttachmentInput": {
				"description": "A file to store on a draft. Send either `content` or a `path` URL. Unlike `POST /emails` attachments, a `path` file is downloaded when the request is made, not when the draft is sent, and a draft attachment cannot use `content_id`. When both `content` and `path` are sent, `path` is ignored.",
				"properties": {
					"content": {
						"description": "The content of the file, encoded in base64. It cannot be empty. Required without `path`.",
						"example": "aGVsbG8gZTJl",
						"type": "string"
					},
					"content_type": {
						"description": "The MIME type of the attachment. It must be a valid MIME type, such as `application/pdf`, or the request returns a 422. Required with `content`. With `path`, it defaults to the content type of the downloaded file.",
						"example": "application/pdf",
						"minLength": 1,
						"type": "string"
					},
					"filename": {
						"description": "The filename of the attachment. A blocked file type returns a 422.",
						"example": "receipt.pdf",
						"minLength": 1,
						"type": "string"
					},
					"path": {
						"description": "A URL to download the file from, starting with `http` or `https`. Required without `content`. A file that cannot be downloaded returns a 422, and so does a request whose downloads take more than 20 seconds together.",
						"example": "https://example.com/invoice.pdf",
						"type": "string"
					}
				},
				"required": [
					"filename"
				],
				"type": "object"
			}
		},
		"allOf": [
			{
				"anyOf": [
					{
						"required": [
							"to"
						]
					},
					{
						"required": [
							"cc"
						]
					},
					{
						"required": [
							"bcc"
						]
					},
					{
						"required": [
							"subject"
						]
					},
					{
						"required": [
							"text"
						]
					},
					{
						"required": [
							"html"
						]
					},
					{
						"required": [
							"attachments"
						]
					}
				],
				"description": "Send at least one of `to`, `cc`, `bcc`, `subject`, `text`, `html` or `attachments`. Omitted fields are left unchanged. Setting `text` or `html` replaces the whole body, so the body part you omit becomes `null`. The merged draft must contain at least one non-empty field, and its combined recipients cannot exceed 50.",
				"properties": {
					"attachments": {
						"description": "Files to store on the draft. Each one needs a `filename` and either `content` or a `path` URL. A `path` file is downloaded when the request is made and stored on the draft. When both are sent, `path` is ignored. A `content_id` returns a 422. The files on a draft, downloaded ones included, can total at most 25 MB. A `path` that does not start with `http` or `https`, or that cannot be downloaded, returns a 422, and so does a request whose downloads take more than 20 seconds together. An empty file or a blocked file type returns a 422. Sending the field replaces every attachment on the draft. Send `[]` to remove them all. `null` also removes them all.",
						"items": {
							"$ref": "#/$defs/InboxDraftAttachmentInput"
						},
						"type": [
							"array",
							"null"
						]
					},
					"bcc": {
						"description": "The BCC recipients. Pass `null` or `[]` to clear. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					},
					"cc": {
						"description": "The CC recipients. Pass `null` or `[]` to clear. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					},
					"html": {
						"description": "The HTML body. Pass `null` to clear.",
						"type": [
							"string",
							"null"
						]
					},
					"subject": {
						"description": "The subject. Max 2000 characters. Cannot be only whitespace or contain a line break. Pass `null` to clear.",
						"example": "Refund issued for order 1041",
						"maxLength": 2000,
						"minLength": 1,
						"type": [
							"string",
							"null"
						]
					},
					"text": {
						"description": "The plain text body. Pass `null` to clear.",
						"type": [
							"string",
							"null"
						]
					},
					"to": {
						"description": "The recipients. For multiple addresses, send an array of strings. Each value can include a friendly name. Pass `null` to clear. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"example": [
							"ada@example.org"
						],
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					}
				},
				"type": "object"
			}
		],
		"examples": [
			{
				"draft_id": "00000000-0000-4000-8000-000000000002",
				"inbox_id": "support@example.com",
				"text": "Thanks for the invoice. We will review it this week."
			}
		],
