	"forwardThreadEmail": {
		"$defs": {
			"Attachment": {
				"anyOf": [
					{
						"required": [
							"content"
						]
					},
					{
						"required": [
							"path"
						]
					}
				],
				"properties": {
					"content": {
						"contentEncoding": "base64",
						"description": "Base64 file contents; files may instead be supplied by a public URL in path.",
						"type": "string"
					},
					"content_id": {
						"description": "Content ID for embedding inline images using cid references (e.g., cid:image001).",
						"type": "string"
					},
					"content_type": {
						"description": "Optional content type for the attachment, if not set it will be derived from the filename property",
						"type": "string"
					},
					"filename": {
						"description": "Name of attached file.",
						"type": "string"
					},
					"path": {
						"description": "Path where the attachment file is hosted",
						"type": "string"
					}
				},
				"type": "object"
			}
		},
		"allOf": [
			{
				"properties": {
					"attachments": {
						"description": "Files to attach, as on `POST /emails`. Each one needs `content` or `path`. They share one limit with the attachments of the original message, which the forward also sends. Together they can have at most 25 MB of `content`. A `path` file does not count toward the 25 MB, because it is fetched when the email is sent. An empty file, a blocked file type, a `path` that does not start with `http` or that starts with `http://localhost:`, or a `content_type` that is not a valid MIME type returns a 422. Other `path` problems fail the email when it is sent, not the request.",
						"items": {
							"$ref": "#/$defs/Attachment"
						},
						"type": [
							"array",
							"null"
						]
					},
					"bcc": {
						"description": "BCC recipient email address. For multiple addresses, send as an array of strings. Counts toward the 50-recipient limit. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"example": [
							"records@acme.com"
						],
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					},
					"cc": {
						"description": "CC recipient email address. For multiple addresses, send as an array of strings. Counts toward the 50-recipient limit. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"example": [
							"billing@acme.com"
						],
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					},
					"headers": {
						"additionalProperties": {
							"type": "string"
						},
						"description": "Custom headers to add to the email. The `In-Reply-To`, `References` and `Reply-To` headers are set by Resend and cannot be set here. Sending one of them, in any letter case, returns a 422. Header names cannot be empty, and names and values cannot contain line breaks or null characters, or the request returns a 422. `null` means no custom headers.",
						"example": {
							"X-Ticket-Id": "4821"
						},
						"type": [
							"object",
							"null"
						]
					},
					"html": {
						"description": "An HTML note sent above the quoted original.",
						"example": "\u003cp\u003eFlagging this refund request for you.\u003c/p\u003e",
						"type": "string"
					},
					"subject": {
