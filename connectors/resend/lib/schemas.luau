	"createDraft": {
		"$defs": {
			"InboxDraftAttachmentInput": {
				"description": "A file to store on a draft. Send either `content` or a `path` URL. Unlike `POST /emails` attachments, a `path` file is downloaded when the request is made, not when the draft is sent, and a draft attachment cannot use `content_id`. When both `content` and `path` are sent, `path` is ignored.",
				"properties": {
					"content": {
						"description": "The content of the file, encoded in base64. It cannot be empty. Required without `path`.",
						"example": "aGVsbG8gZTJl",
						"type": "string"
					},
					"content_type": {
						"description": "The MIME type of the attachment. It must be a valid MIME type, such as `application/pdf`, or the request returns a 422. Required with `content`. With `path`, it defaults to the content type of the downloaded file.",
						"example": "application/pdf",
						"minLength": 1,
						"type": "string"
					},
					"filename": {
						"description": "The filename of the attachment. A blocked file type returns a 422.",
						"example": "receipt.pdf",
						"minLength": 1,
						"type": "string"
					},
					"path": {
						"description": "A URL to download the file from, starting with `http` or `https`. Required without `content`. A file that cannot be downloaded returns a 422, and so does a request whose downloads take more than 20 seconds together.",
						"example": "https://example.com/invoice.pdf",
						"type": "string"
					}
				},
				"required": [
					"filename"
				],
				"type": "object"
			}
		},
		"allOf": [
			{
				"description": "At least one of `to`, `cc`, `bcc`, `subject`, `text`, `html` or `attachments` must be non-empty. The combined recipients of `to`, `cc` and `bcc` cannot exceed 50. `thread_id` and `reply_to_email_id` must be sent together or not at all.",
				"properties": {
					"attachments": {
						"description": "Files to store on the draft. Each one needs a `filename` and either `content` or a `path` URL. A `path` file is downloaded when the request is made and stored on the draft. When both are sent, `path` is ignored. A `content_id` returns a 422. The files on a draft, downloaded ones included, can total at most 25 MB. A `path` that does not start with `http` or `https`, or that cannot be downloaded, returns a 422, and so does a request whose downloads take more than 20 seconds together. An empty file or a blocked file type returns a 422.",
						"items": {
							"$ref": "#/$defs/InboxDraftAttachmentInput"
						},
						"type": [
							"array",
							"null"
						]
					},
					"bcc": {
						"description": "The BCC recipients. For multiple addresses, send an array of strings. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					},
					"cc": {
						"description": "The CC recipients. For multiple addresses, send an array of strings. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					},
					"html": {
						"description": "The HTML body.",
						"example": "\u003cp\u003eRefund issued for order 1041.\u003c/p\u003e",
						"type": [
							"string",
							"null"
						]
					},
					"reply_to_email_id": {
						"description": "The Email ID to reply to, as returned in `data[].id` by the list thread emails endpoint. Must be sent with `thread_id`.",
						"example": "5b1a9f47-2c8d-4e6f-9a03-1d2e3f4a5b60",
						"format": "uuid",
						"type": "string"
					},
					"subject": {
						"description": "The subject. Max 2000 characters. A string that is only whitespace, or that contains a line break, is rejected.",
						"example": "Refund for order 1041",
						"maxLength": 2000,
						"minLength": 1,
						"type": [
							"string",
							"null"
						]
					},
					"text": {
						"description": "The plain text body.",
						"example": "Refund issued for order 1041.",
						"type": [
							"string",
							"null"
						]
					},
					"thread_id": {
						"description": "The Thread ID to reply in. Must be sent with `reply_to_email_id`.",
						"example": "4d8e2a1c-9b3f-4c6d-8a21-3e5f7c9c0d12",
						"format": "uuid",
						"type": "string"
					},
					"to": {
						"description": "The recipients. For multiple addresses, send an array of strings. Each value can include a friendly name, for example `Ada Lovelace \u003cada@example.org\u003e`. Each address is `email@example.com` or `Name \u003cemail@example.com\u003e`. An address that is not valid returns a 422.",
						"example": [
							"ada@example.org"
						],
						"oneOf": [
							{
								"type": "string"
							},
							{
								"items": {
									"type": "string"
								},
								"maxItems": 50,
								"type": "array"
							},
							{
								"type": "null"
							}
						]
					}
				},
				"type": "object"
			}
		],
		"examples": [
