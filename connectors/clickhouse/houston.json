{
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    },
    "database": {
      "label": "Database",
      "order": 3,
      "required": true,
      "type": "string"
    },
    "host": {
      "label": "Host",
      "order": 2,
      "required": true,
      "type": "string"
    },
    "password": {
      "label": "Password",
      "order": 5,
      "required": true,
      "type": "secret"
    },
    "transport": {
      "default": "https",
      "label": "Transport",
      "options": [
        {
          "label": "HTTPS",
          "value": "https"
        },
        {
          "label": "Native TLS",
          "value": "native"
        }
      ],
      "order": 2,
      "type": "string"
    },
    "username": {
      "label": "Username",
      "order": 4,
      "required": true,
      "type": "string"
    }
  },
  "description": "SQL access to a ClickHouse database.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "ClickHouse",
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "{{config.database}}",
          "host": "{{config.host}}",
          "password": "{{config.password}}",
          "tls": {
            "mode": "verify-full"
          },
          "transport": "{{config.transport}}",
          "user": "{{config.username}}"
        }
      },
      "match": {
        "protocol": "clickhouse"
      }
    }
  ],
  "schema_version": 1,
  "setup": "Enter the database host, database name, username and password separately. TLS verifies the server certificate and hostname. Use a database role limited to the operations you want to share. Query uses the database read-only transaction support; execute is available when Access is Read and write."
}
