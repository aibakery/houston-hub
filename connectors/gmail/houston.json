{
  "connection_label": [
    {
      "if": "{{ isDefined auth.composio }}",
      "request": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile"
      },
      "select": "/emailAddress"
    },
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "select": "/email"
    }
  ],
  "schema_version": 2,
  "name": "Gmail",
  "verification_key": "f8f70b3e9c1ae4e9b94e4cabb680db1c7ac85847721986fa399925cfdc79b980",
  "warning": "**Pending Google approval.** Google is still reviewing Houston's access to Gmail. Until Google approves it, you will see a *Google hasn't verified this app* screen while connecting with Google: select **Advanced**, then continue to Houston.",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "messages",
      "label": "Messages",
      "description": "Read lets agents search and read your mail, threads, attachments and labels. Organize also lets them archive, mark read or unread, apply labels, and create, rename and delete labels. Agents can never delete mail.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "organize",
          "label": "Organize"
        }
      ],
      "default": "read"
    },
    {
      "name": "drafts",
      "label": "Drafts",
      "description": "Create lets agents write new drafts for you to review and send in Gmail. Manage also lets them read, edit and delete your drafts. Houston never sends a draft, even though Google's permission for Manage mentions sending.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "create",
          "label": "Create"
        },
        {
          "value": "manage",
          "label": "Manage"
        }
      ],
      "default": "none"
    },
    {
      "name": "sending",
      "label": "Sending",
      "description": "Send lets agents send new mail and replies from your address.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "send",
          "label": "Send"
        }
      ],
      "default": "none"
    }
  ],
  "auth": {
    "composio": {
      "account": {
        "label": "/emailAddress",
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile"
      },
      "api_key": "{{publisher.composio_api_key}}",
      "app": "gmail",
      "auth_config_id": "{{publisher.composio_auth_config_id}}",
      "description": "Composio requires full Gmail access. Houston limits its use to the access level you select.",
      "label": "Connect with Composio",
      "order": 2,
      "type": "composio"
    },
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "brand": "google",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect with Google",
      "order": 1,
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "if": "{{ allows access.messages \"read\" }}",
          "values": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/gmail.messages.readonly"
          ]
        },
        {
          "if": "{{ is access.messages \"read\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.labels.readonly"
          ]
        },
        {
          "if": "{{ allows access.messages \"organize\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.messages.modify",
            "https://www.googleapis.com/auth/gmail.labels"
          ]
        },
        {
          "if": "{{ is access.drafts \"create\" }}",
          "values": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/gmail.drafts.create"
          ]
        },
        {
          "if": "{{ allows access.drafts \"manage\" }}",
          "values": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/gmail.drafts"
          ]
        },
        {
          "if": "{{ allows access.sending \"send\" }}",
          "values": [
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/gmail.send"
          ]
        }
      ],
      "token_url": "https://oauth2.googleapis.com/token",
      "type": "oauth2"
    }
  },
  "publisher": {
    "client_id": {
      "label": "Google OAuth client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "Google OAuth client secret",
      "order": 2,
      "type": "secret"
    },
    "composio_api_key": {
      "description": "Use an API key from the project that owns the Gmail auth config, with Proxy execute enabled. Composio is offered only when both fields are filled in.",
      "label": "Composio project API key",
      "order": 4,
      "type": "secret"
    },
    "composio_auth_config_id": {
      "description": "Create a Gmail OAuth2 auth config using Composio-managed credentials and the https://mail.google.com/ scope. Copy its ac_ ID here. Leave blank to offer only direct Google sign-in.",
      "label": "Composio Gmail auth config ID",
      "order": 3,
      "type": "string"
    }
  },
  "proxy": [
    {
      "if": "{{ allows access.messages \"read\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/gmail/v1/users/me/labels",
          "/gmail/v1/users/me/labels/{id}",
          "/gmail/v1/users/me/messages",
          "/gmail/v1/users/me/messages/{id}",
          "/gmail/v1/users/me/messages/{id}/attachments/{attachmentId}",
          "/gmail/v1/users/me/threads",
          "/gmail/v1/users/me/threads/{id}",
          "/gmail/v1/users/me/history"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ and (isDefined auth.oauth) (allows access.messages \"read\") }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/oauth2/v2/userinfo"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ and (isDefined auth.composio) (allows access.messages \"read\") }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/gmail/v1/users/me/profile"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.drafts \"manage\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/gmail/v1/users/me/drafts",
          "/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.drafts \"create\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.drafts \"manage\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.drafts \"manage\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.messages \"organize\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/gmail/v1/users/me/messages/batchModify",
          "/gmail/v1/users/me/messages/{id}/modify",
          "/gmail/v1/users/me/threads/{id}/modify",
          "/gmail/v1/users/me/labels"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.messages \"organize\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/labels/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ allows access.sending \"send\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/gmail/v1/users/me/messages/send"
        ],
        "protocol": "http"
      }
    }
  ]
}
