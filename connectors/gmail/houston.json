{
  "schema_version": 1,
  "name": "Gmail",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "type": "string",
      "label": "Access",
      "default": "read-only",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ]
    }
  },
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Google",
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "S256",
      "require_refresh": true,
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "scopes": [
        {
          "values": [
            "https://www.googleapis.com/auth/userinfo.email"
          ]
        },
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.readonly"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.modify"
          ]
        }
      ],
      "account": {
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email"
      }
    }
  },
  "publisher": {
    "client_id": {
      "type": "string",
      "label": "Google OAuth client ID",
      "required": true,
      "order": 1
    },
    "client_secret": {
      "type": "secret",
      "label": "Google OAuth client secret",
      "required": true,
      "order": 2
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET",
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/*",
          "/upload/gmail/v1/users/me/*"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    }
  ]
}
