{
  "schema_version": 1,
  "name": "Gmail",
  "warning": "**Direct Google sign-in is pending approval.**",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "description": "Read and draft lets agents create, edit and delete drafts. You review and send them yourself in Gmail.",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and draft",
          "value": "custom"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    }
  },
  "auth": {
    "composio": {
      "account": {
        "label": "/emailAddress",
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile"
      },
      "api_key": "{{publisher.composio_api_key}}",
      "app": "gmail",
      "auth_config_id": "{{publisher.composio_auth_config_id}}",
      "description": "Composio requires full Gmail access. Houston limits its use to the access level you select.",
      "label": "Connect with Composio",
      "order": 1,
      "type": "composio"
    },
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "availability": {
        "message": "Waiting for Google approval",
        "status": "preview"
      },
      "brand": "google",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect with Google",
      "order": 2,
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "https://www.googleapis.com/auth/userinfo.email"
          ]
        },
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.readonly"
          ]
        },
        {
          "if": "{{ is config.access \"custom\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.readonly",
            "https://www.googleapis.com/auth/gmail.compose"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.modify"
          ]
        }
      ],
      "token_url": "https://oauth2.googleapis.com/token",
      "type": "oauth2"
    }
  },
  "publisher": {
    "client_id": {
      "label": "Google OAuth client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "Google OAuth client secret",
      "order": 2,
      "type": "secret"
    },
    "composio_api_key": {
      "description": "Use an API key from the project that owns the Gmail auth config, with Proxy execute enabled. Composio is offered only when both fields are filled in.",
      "label": "Composio project API key",
      "order": 4,
      "type": "secret"
    },
    "composio_auth_config_id": {
      "description": "Create a Gmail OAuth2 auth config using Composio-managed credentials and the https://mail.google.com/ scope. Copy its ac_ ID here. Leave blank to offer only direct Google sign-in.",
      "label": "Composio Gmail auth config ID",
      "order": 3,
      "type": "string"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/gmail/v1/users/me/profile",
          "/gmail/v1/users/me/labels",
          "/gmail/v1/users/me/labels/{id}",
          "/gmail/v1/users/me/messages",
          "/gmail/v1/users/me/messages/{id}",
          "/gmail/v1/users/me/messages/{id}/attachments/{attachmentId}",
          "/gmail/v1/users/me/threads",
          "/gmail/v1/users/me/threads/{id}",
          "/gmail/v1/users/me/drafts",
          "/gmail/v1/users/me/drafts/{id}",
          "/gmail/v1/users/me/history",
          "/gmail/v1/users/me/settings/sendAs"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/gmail/v1/users/me/messages/batchModify",
          "/gmail/v1/users/me/messages/{id}/modify",
          "/gmail/v1/users/me/messages/{id}/trash",
          "/gmail/v1/users/me/messages/{id}/untrash",
          "/gmail/v1/users/me/threads/{id}/modify",
          "/gmail/v1/users/me/threads/{id}/trash",
          "/gmail/v1/users/me/threads/{id}/untrash",
          "/gmail/v1/users/me/labels",
          "/gmail/v1/users/me/drafts/send",
          "/upload/gmail/v1/users/me/messages/send",
          "/upload/gmail/v1/users/me/drafts"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/labels/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"custom\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"custom\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "if": "{{ is config.access \"custom\" }}",
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    }
  ]
}
