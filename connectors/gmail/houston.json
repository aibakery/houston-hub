{
  "schema_version": 1,
  "name": "Gmail",
  "warning": "**Direct Google sign-in is pending approval.** Connect through Pipedream while Google reviews Houston's application. Existing direct Google connections continue to work.",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "description": "Read and draft lets agents create, update and delete drafts for you to review and send from Gmail; Houston refuses every send request on that level.",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and draft",
          "value": "custom"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    }
  },
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "availability": {
        "message": "Waiting for Google approval",
        "status": "preview"
      },
      "brand": "google",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect with Google",
      "order": 2,
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "https://www.googleapis.com/auth/userinfo.email"
          ]
        },
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.readonly"
          ]
        },
        {
          "if": "{{ is config.access \"custom\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.readonly",
            "https://www.googleapis.com/auth/gmail.compose"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.modify"
          ]
        }
      ],
      "token_url": "https://oauth2.googleapis.com/token",
      "type": "oauth2"
    },
    "pipedream": {
      "account": {
        "label": "/emailAddress",
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile"
      },
      "app": "gmail",
      "client_id": "{{publisher.pipedream_client_id}}",
      "client_secret": "{{publisher.pipedream_client_secret}}",
      "environment": "{{publisher.pipedream_environment}}",
      "label": "Connect with Pipedream",
      "order": 1,
      "project_id": "{{publisher.pipedream_project_id}}",
      "scopes": [
        {
          "values": [
            "https://www.googleapis.com/auth/gmail.modify",
            "https://www.googleapis.com/auth/gmail.settings.basic"
          ]
        }
      ],
      "type": "pipedream"
    }
  },
  "publisher": {
    "client_id": {
      "label": "Google OAuth client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "Google OAuth client secret",
      "order": 2,
      "type": "secret"
    },
    "pipedream_client_id": {
      "label": "Pipedream OAuth client ID",
      "order": 3,
      "type": "string"
    },
    "pipedream_client_secret": {
      "label": "Pipedream OAuth client secret",
      "order": 4,
      "type": "secret"
    },
    "pipedream_environment": {
      "default": "development",
      "label": "Pipedream environment",
      "options": [
        {
          "label": "Development",
          "value": "development"
        },
        {
          "label": "Production",
          "value": "production"
        }
      ],
      "order": 6,
      "type": "string"
    },
    "pipedream_project_id": {
      "label": "Pipedream project ID",
      "order": 5,
      "type": "string"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/gmail/v1/users/me/profile",
          "/gmail/v1/users/me/labels",
          "/gmail/v1/users/me/labels/{id}",
          "/gmail/v1/users/me/messages",
          "/gmail/v1/users/me/messages/{id}",
          "/gmail/v1/users/me/messages/{id}/attachments/{attachmentId}",
          "/gmail/v1/users/me/threads",
          "/gmail/v1/users/me/threads/{id}",
          "/gmail/v1/users/me/drafts",
          "/gmail/v1/users/me/drafts/{id}",
          "/gmail/v1/users/me/history",
          "/gmail/v1/users/me/settings/sendAs"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/gmail/v1/users/me/messages/batchModify",
          "/gmail/v1/users/me/messages/{id}/modify",
          "/gmail/v1/users/me/messages/{id}/trash",
          "/gmail/v1/users/me/messages/{id}/untrash",
          "/gmail/v1/users/me/threads/{id}/modify",
          "/gmail/v1/users/me/threads/{id}/trash",
          "/gmail/v1/users/me/threads/{id}/untrash",
          "/gmail/v1/users/me/labels",
          "/gmail/v1/users/me/drafts/send",
          "/upload/gmail/v1/users/me/messages/send",
          "/upload/gmail/v1/users/me/drafts"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/labels/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"custom\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"custom\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "if": "{{ is config.access \"custom\" }}",
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/upload/gmail/v1/users/me/drafts/{id}"
        ],
        "protocol": "http"
      }
    }
  ]
}
