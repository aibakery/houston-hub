{
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "client_auth": "body",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "label": "Connect account",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "openid",
            "email",
            "https://www.googleapis.com/auth/gmail.readonly"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "https://www.googleapis.com/auth/gmail.modify"
          ]
        }
      ],
      "token_url": "https://oauth2.googleapis.com/token",
      "type": "oauth2"
    }
  },
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    },
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "description": "Read-only access to Gmail.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Gmail",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "gmail.googleapis.com"
        ],
        "method": [
          "GET",
          "HEAD",
          "POST",
          "PUT",
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/*"
        ],
        "protocol": "http"
      }
    }
  ],
  "schema_version": 1,
  "setup": "Create an OAuth application with your provider and enter its client ID and client secret in this connection's settings. Copy the OAuth callback URL shown here into that application's allowed redirect URLs before authorizing. Every Houston connection gets a different callback URL; reauthorizing the same connection keeps it. Houston will ask Google for permission, then keep the token on this server. Your mail stays in Google."
}
