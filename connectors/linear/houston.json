{
  "connection_label": [
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          },
          "apollo-require-preflight": {
            "value": "true"
          }
        },
        "method": "GET",
        "url": "https://api.linear.app/graphql?query=%7Bviewer%7Bemail%7D%7D"
      },
      "select": "/data/viewer/email"
    },
    {
      "if": "{{ isDefined auth.token }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "{{auth.token.token}}"
          },
          "apollo-require-preflight": {
            "value": "true"
          }
        },
        "method": "GET",
        "url": "https://api.linear.app/graphql?query=%7Bviewer%7Bemail%7D%7D"
      },
      "select": "/data/viewer/email"
    }
  ],
  "schema_version": 2,
  "name": "Linear",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "config": {
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "type": "secret"
    }
  },
  "auth": {
    "token": {
      "type": "manual",
      "label": "Personal API key",
      "order": 1,
      "config": {
        "token": {
          "label": "Personal API key",
          "required": true,
          "type": "secret"
        }
      }
    },
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Linear",
      "brand": "linear",
      "order": 2,
      "authorize_url": "https://linear.app/oauth/authorize",
      "token_url": "https://api.linear.app/oauth/token",
      "client_auth": "body",
      "pkce": "S256",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "require_refresh": true,
      "scopes": [
        {
          "if": "{{ is access.data \"read\" }}",
          "values": [
            "read"
          ]
        },
        {
          "if": "{{ is access.data \"write\" }}",
          "values": [
            "write"
          ]
        }
      ],
      "account": {
        "url": "https://api.linear.app/graphql?query=%7Bviewer%7Bemail%7D%7D",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          },
          "apollo-require-preflight": {
            "value": "true"
          }
        },
        "label": "/data/viewer/email"
      }
    }
  },
  "proxy": [
    {
      "if": "{{ isDefined auth.token }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.linear.app"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/graphql"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "{{auth.token.token}}"
          }
        }
      }
    },
    {
      "if": "{{ isDefined auth.oauth }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.linear.app"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/graphql"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ and (allows access.data \"write\") (isDefined auth.token) }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.linear.app"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/graphql"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "{{auth.token.token}}"
          }
        }
      }
    },
    {
      "if": "{{ and (allows access.data \"write\") (isDefined auth.oauth) }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.linear.app"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/graphql"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    }
  ]
}
