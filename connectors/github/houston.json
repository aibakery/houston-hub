          "/search/repositories",
          "/search/users",
          "/user",
          "/user/emails",
          "/user/installations",
          "/user/installations/{installation_id}/repositories",
          "/user/orgs",
          "/user/repos",
          "/users/{username}",
          "/users/{username}/gists",
          "/users/{username}/repos"
        ],
        "protocol": "http"
      }
    },
    {
