{
  "schema_version": 1,
  "name": "GitHub",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    }
  },
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          },
          "Accept": {
            "value": "application/vnd.github+json"
          }
        },
        "label": "/login",
        "method": "GET",
        "url": "https://api.github.com/user"
      },
      "authorize_url": "https://github.com/login/oauth/authorize",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect with GitHub",
      "pkce": "S256",
      "require_refresh": true,
      "token_headers": {
        "Accept": "application/json"
      },
      "token_url": "https://github.com/login/oauth/access_token",
      "type": "oauth2"
    },
    "token": {
      "config": {
        "token": {
          "label": "Token",
          "required": true,
          "type": "secret"
        }
      },
      "label": "Personal access token",
      "type": "manual"
    }
  },
  "publisher": {
    "client_id": {
      "label": "GitHub App client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "GitHub App client secret",
      "order": 2,
      "type": "secret"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token || auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.github.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/gists",
          "/gists/{gist_id}",
          "/issues",
          "/notifications",
          "/orgs/{org}",
          "/orgs/{org}/members",
          "/orgs/{org}/repos",
          "/orgs/{org}/teams",
          "/orgs/{org}/teams/{team_slug}/members",
          "/rate_limit",
          "/repos/{owner}/{repo}",
          "/repos/{owner}/{repo}/actions/artifacts",
          "/repos/{owner}/{repo}/actions/artifacts/{artifact_id}/{archive_format}",
          "/repos/{owner}/{repo}/actions/jobs/{job_id}",
          "/repos/{owner}/{repo}/actions/jobs/{job_id}/logs",
          "/repos/{owner}/{repo}/actions/runs",
          "/repos/{owner}/{repo}/actions/runs/{run_id}",
          "/repos/{owner}/{repo}/actions/runs/{run_id}/artifacts",
          "/repos/{owner}/{repo}/actions/runs/{run_id}/jobs",
          "/repos/{owner}/{repo}/actions/runs/{run_id}/logs",
          "/repos/{owner}/{repo}/actions/workflows",
          "/repos/{owner}/{repo}/actions/workflows/{workflow_id}",
          "/repos/{owner}/{repo}/actions/workflows/{workflow_id}/runs",
          "/repos/{owner}/{repo}/assignees",
          "/repos/{owner}/{repo}/branches",
          "/repos/{owner}/{repo}/check-runs/{check_run_id}",
          "/repos/{owner}/{repo}/check-runs/{check_run_id}/annotations",
          "/repos/{owner}/{repo}/collaborators",
          "/repos/{owner}/{repo}/commits",
          "/repos/{owner}/{repo}/commits/{commit_sha}/pulls",
          "/repos/{owner}/{repo}/contributors",
          "/repos/{owner}/{repo}/forks",
          "/repos/{owner}/{repo}/git/blobs/{file_sha}",
          "/repos/{owner}/{repo}/git/commits/{commit_sha}",
          "/repos/{owner}/{repo}/issues",
          "/repos/{owner}/{repo}/issues/{issue_number}",
          "/repos/{owner}/{repo}/issues/{issue_number}/comments",
          "/repos/{owner}/{repo}/issues/{issue_number}/sub_issues",
          "/repos/{owner}/{repo}/issues/{issue_number}/timeline",
          "/repos/{owner}/{repo}/labels",
          "/repos/{owner}/{repo}/languages",
          "/repos/{owner}/{repo}/milestones",
          "/repos/{owner}/{repo}/milestones/{milestone_number}",
          "/repos/{owner}/{repo}/pulls",
          "/repos/{owner}/{repo}/pulls/{pull_number}",
