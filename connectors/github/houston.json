  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          },
          "Accept": {
            "value": "application/vnd.github+json"
          }
        },
        "label": "/login",
        "method": "GET",
        "url": "https://api.github.com/user"
      },
      "authorize_url": "https://github.com/login/oauth/authorize",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect with GitHub",
      "brand": "github",
      "pkce": "S256",
      "require_refresh": true,
      "token_headers": {
        "Accept": "application/json"
      },
      "token_url": "https://github.com/login/oauth/access_token",
      "type": "oauth2"
    },
    "token": {
      "config": {
        "token": {
          "label": "Token",
          "required": true,
          "type": "secret"
        }
      },
      "label": "Personal access token",
      "setup_url": "https://github.com/settings/personal-access-tokens/new?name=Houston&description=Houston%20connection",
      "setup_params": {
        "contents": "code",
        "issues": "conversations",
        "pull_requests": "conversations",
        "actions": "actions",
        "statuses": "actions",
        "starring": "stars",
        "members": "organizations",
        "emails": "emails",
        "administration": "repositories"
      },
      "type": "manual"
    }
  },
  "publisher": {
    "client_id": {
      "label": "GitHub App client ID",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "GitHub App client secret",
      "order": 2,
      "type": "secret"
    }
  },
