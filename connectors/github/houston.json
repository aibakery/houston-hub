{
  "connection_label": [
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Accept": {
            "value": "application/vnd.github+json"
          },
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "method": "GET",
        "url": "https://api.github.com/user"
      },
      "select": "/login"
    },
    {
      "if": "{{ isDefined auth.token }}",
      "request": {
        "headers": {
          "Accept": {
            "value": "application/vnd.github+json"
          },
          "Authorization": {
            "value": "Bearer {{auth.token.token}}"
          }
        },
        "method": "GET",
        "url": "https://api.github.com/user"
      },
      "select": "/login"
    }
  ],
  "schema_version": 2,
  "name": "GitHub",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "code",
      "label": "Code and releases",
      "description": "Files, branches, commits, merges and releases, including archives and release downloads.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    },
    {
      "name": "conversations",
      "label": "Issues and pull requests",
      "description": "Issues, pull requests, comments, reviews, labels and milestones. Pull request files, commits and merges also need Code.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    },
    {
      "name": "actions",
      "label": "Actions, checks and statuses",
      "description": "Workflows, runs, jobs, logs, artifacts, check runs and commit statuses.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    },
    {
      "name": "gists",
      "label": "Gists",
      "description": "Gists and their files.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "none"
    },
    {
      "name": "stars",
      "label": "Stars",
      "description": "Starred repositories.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "none"
    },
    {
      "name": "organizations",
      "label": "Organizations and teams",
      "description": "Your organizations, their members and teams.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        }
      ],
      "default": "read"
    },
    {
      "name": "emails",
      "label": "Email addresses",
      "description": "Your email addresses, including private ones.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        }
      ],
      "default": "none"
    },
    {
      "name": "repositories",
      "label": "Create and fork repositories",
      "description": "New repositories in your account or organizations, and forks.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "none"
    }
