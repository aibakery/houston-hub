{
  "config": {
    "database": {
      "label": "Database",
      "order": 3,
      "required": true,
      "type": "string"
    },
    "host": {
      "label": "Host",
      "order": 2,
      "required": true,
      "type": "string"
    },
    "password": {
      "label": "Password",
      "order": 5,
      "required": true,
      "type": "secret"
    },
    "port": {
      "default": 3306,
      "label": "Port",
      "maximum": 65535,
      "minimum": 1,
      "order": 3,
      "type": "integer"
    },
    "username": {
      "label": "Username",
      "order": 4,
      "required": true,
      "type": "string"
    }
  },
  "description": "Read-only SQL over a MySQL connection URL.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "MySQL",
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "{{config.database}}",
          "host": "{{config.host}}",
          "password": "{{config.password}}",
          "port": "{{config.port}}",
          "tls": {
            "mode": "verify-full"
          },
          "user": "{{config.username}}"
        }
      },
      "match": {
        "protocol": "mysql"
      }
    }
  ],
  "schema_version": 1,
  "setup": "Enter the database host, database name, username and password separately. TLS verifies the server certificate and hostname. Use a database role limited to the operations you want to share. Query uses the database read-only transaction support; execute is available when Access is Read and write."
}
