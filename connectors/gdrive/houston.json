{
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect account",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "openid",
            "email",
            "https://www.googleapis.com/auth/drive.readonly"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "https://www.googleapis.com/auth/drive"
          ]
        }
      ],
      "token_url": "https://oauth2.googleapis.com/token",
      "type": "oauth2"
    }
  },
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    }
  },
  "description": "Read-only access to Google Drive.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "implements": [
    "files.metadata@1"
  ],
  "name": "Google Drive",
  "proxy": [
    {
      "origins": {
        "https://www.googleapis.com": {
          "allowlist": [
            {
              "methods": [
                "GET",
                "HEAD",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
              ],
              "paths": [
                "/drive/*",
                "/upload/drive/*"
              ]
            }
          ],
          "headers": {
            "Authorization": {
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      },
      "protocol": "http"
    }
  ],
  "publisher": {
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "schema_version": 1,
  "setup": "Houston will ask Google for permission, then keep the token on this server. Your files stay in Google."
}
