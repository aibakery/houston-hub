{
  "connection_label": [
    {
      "if": "{{ isDefined auth.composio }}",
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/about?fields=user"
      },
      "select": "/user/emailAddress"
    },
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo"
      },
      "select": "/email"
    }
  ],
  "schema_version": 2,
  "name": "Google Drive",
  "warning": "**Pending Google approval.** Google is still reviewing Houston's access to Google Drive. Until Google approves it, you will see a *Google hasn't verified this app* screen while connecting with Google: select **Advanced**, then continue to Houston.",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "auth": {
    "composio": {
      "type": "composio",
      "label": "Connect with Composio",
      "description": "Composio requires full Google Drive access. Houston limits its use to the access level you select.",
      "order": 2,
      "app": "googledrive",
      "auth_config_id": "{{publisher.composio_auth_config_id}}",
      "api_key": "{{publisher.composio_api_key}}",
      "account": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/about?fields=user",
        "label": "/user/emailAddress"
      }
    },
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Google",
      "order": 1,
      "brand": "google",
      "authorize_url": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_url": "https://oauth2.googleapis.com/token",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "S256",
      "require_refresh": true,
      "authorize_params": {
        "access_type": "offline",
        "include_granted_scopes": "false",
        "prompt": "consent"
      },
      "scopes": [
        {
          "values": [
            "https://www.googleapis.com/auth/userinfo.email"
          ]
        },
        {
          "if": "{{ is access.data \"read\" }}",
          "values": [
            "https://www.googleapis.com/auth/drive.readonly"
          ]
        },
        {
          "if": "{{ is access.data \"write\" }}",
          "values": [
            "https://www.googleapis.com/auth/drive"
          ]
        }
      ],
      "account": {
        "method": "GET",
        "url": "https://www.googleapis.com/oauth2/v2/userinfo",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email"
      }
    }
  },
  "publisher": {
    "client_id": {
      "type": "string",
      "label": "Google OAuth client ID",
      "required": true,
      "order": 1
    },
    "client_secret": {
      "type": "secret",
      "label": "Google OAuth client secret",
      "required": true,
      "order": 2
    },
    "composio_auth_config_id": {
      "type": "string",
      "label": "Composio Google Drive auth config ID",
      "description": "Create a Google Drive OAuth2 auth config using Composio-managed credentials and the https://www.googleapis.com/auth/drive scope. Copy its ac_ ID here. Leave blank to offer only direct Google sign-in.",
      "order": 3
    },
    "composio_api_key": {
      "type": "secret",
      "label": "Composio project API key",
      "description": "Use an API key from the project that owns the Google Drive auth config, with Proxy execute enabled. Composio is offered only when both fields are filled in.",
      "order": 4
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/drive/v3/about",
          "/drive/v3/files",
          "/drive/v3/files/{fileId}",
          "/drive/v3/files/{fileId}/export",
          "/drive/v3/files/{fileId}/permissions",
          "/drive/v3/drives"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/drive/v3/files",
          "/drive/v3/files/{fileId}/copy",
          "/drive/v3/files/{fileId}/permissions",
          "/upload/drive/v3/files"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "PATCH"
        ],
        "path": [
          "/drive/v3/files/{fileId}",
          "/upload/drive/v3/files/{fileId}"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/drive/v3/files/{fileId}",
          "/drive/v3/files/{fileId}/permissions/{permissionId}"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "www.googleapis.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/upload/drive/v3/files",
          "/upload/drive/v3/files/{fileId}"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ],
          "set": {
            "Authorization": {
              "if": "{{ isDefined auth.oauth }}",
              "value": "Bearer {{auth.oauth.access_token}}"
            }
          }
        }
      }
    }
  ]
}
