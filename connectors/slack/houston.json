{
  "connection_label": [
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "method": "GET",
        "url": "https://slack.com/api/auth.test"
      },
      "select": "/team"
    }
  ],
  "schema_version": 2,
  "name": "Slack",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "channels",
      "label": "Public channels",
      "description": "Public channels you are in: their messages, threads and members.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "read", "label": "Read"}
      ],
      "default": "read"
    },
    {
      "name": "private_channels",
      "label": "Private channels",
      "description": "Private channels you are in: their messages, threads and members.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "read", "label": "Read"}
      ],
      "default": "read"
    },
    {
      "name": "direct_messages",
      "label": "Direct messages",
      "description": "Direct and group direct messages; Write opens new ones.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "read", "label": "Read"},
        {"value": "write", "label": "Write"}
      ],
      "default": "read"
    },
    {
      "name": "search",
      "label": "Search",
      "description": "Message search and your mentions.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "read", "label": "Read"}
      ],
      "default": "read"
    },
    {
      "name": "users",
      "label": "Users",
      "description": "Workspace members and their profiles.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "read", "label": "Read"}
      ],
      "default": "read"
    },
    {
      "name": "files",
      "label": "Files",
      "description": "Download shared files; Write uploads and shares files.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "read", "label": "Read"},
        {"value": "write", "label": "Write"}
      ],
      "default": "read"
    },
    {
      "name": "reactions",
      "label": "Reactions",
      "description": "Add and remove your emoji reactions.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "write", "label": "Write"}
      ],
      "default": "none"
    },
    {
      "name": "messages",
      "label": "Messages",
      "description": "Post, reply, edit and delete messages as you.",
      "levels": [
        {"value": "none", "label": "None"},
        {"value": "write", "label": "Write"}
      ],
      "default": "none"
    }
  ],
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Slack",
      "brand": "slack",
      "authorize_url": "https://slack.com/oauth/v2/authorize",
      "token_url": "https://slack.com/api/oauth.v2.access",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "none",
      "scope_parameter": "user_scope",
      "scope_separator": ",",
      "scopes": [
        {
          "if": "{{ allows access.channels \"read\" }}",
          "values": [
            "channels:read",
            "channels:history"
          ]
        },
        {
          "if": "{{ allows access.private_channels \"read\" }}",
          "values": [
            "groups:read",
            "groups:history"
          ]
        },
        {
          "if": "{{ allows access.direct_messages \"read\" }}",
          "values": [
            "im:read",
            "im:history",
            "mpim:read",
            "mpim:history"
          ]
        },
        {
          "if": "{{ allows access.users \"read\" }}",
          "values": [
            "users:read"
          ]
        },
        {
          "if": "{{ allows access.search \"read\" }}",
          "values": [
            "search:read"
          ]
        },
        {
          "if": "{{ allows access.files \"read\" }}",
          "values": [
            "files:read"
          ]
        },
        {
          "if": "{{ allows access.messages \"write\" }}",
          "values": [
            "chat:write"
          ]
        },
        {
          "if": "{{ allows access.files \"write\" }}",
          "values": [
            "files:write"
          ]
        },
        {
          "if": "{{ allows access.direct_messages \"write\" }}",
          "values": [
            "im:write",
            "mpim:write"
          ]
        },
        {
          "if": "{{ allows access.reactions \"write\" }}",
          "values": [
            "reactions:write"
          ]
        }
      ],
      "token_response": {
        "access_token": "/authed_user/access_token",
        "refresh_token": "/authed_user/refresh_token",
        "expires_in": "/authed_user/expires_in",
        "scopes": "/authed_user/scope",
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          },
          {
            "op": "equals",
            "path": "/authed_user/token_type",
            "value": "user"
          },
          {
            "op": "exists",
            "path": "/team/id"
          },
          {
            "op": "exists",
            "path": "/authed_user/id"
          }
        ]
      },
      "refresh_response": {
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          }
        ]
      },
      "account": {
        "url": "https://slack.com/api/auth.test",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/team",
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          }
        ]
      }
    }
  },
  "publisher": {
    "client_id": {
      "label": "Slack client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "Slack client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/auth.test",
          "/api/users.conversations",
          "/api/conversations.info",
          "/api/conversations.history",
          "/api/conversations.replies",
          "/api/conversations.members",
          "/api/chat.getPermalink"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.search \"read\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/search.messages"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.users \"read\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/users.info",
          "/api/users.list"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.files \"read\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/files.info"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.files \"read\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "files.slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/files-pri/*"
        ],
        "opaque_path_parameters": [
          "*"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.messages \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/chat.postMessage",
          "/api/chat.update",
          "/api/chat.delete"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.direct_messages \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/conversations.open"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.reactions \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/reactions.add",
          "/api/reactions.remove"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.files \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/files.getUploadURLExternal",
          "/api/files.completeUploadExternal"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ allows access.files \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "files.slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/v1/*"
        ],
        "opaque_path_parameters": [
          "*"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ]
        }
      }
    }
  ]
}
