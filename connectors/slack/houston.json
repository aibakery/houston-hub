{
  "schema_version": 1,
  "name": "Slack",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "type": "string"
    }
  },
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Slack",
      "authorize_url": "https://slack.com/oauth/v2/authorize",
      "token_url": "https://slack.com/api/oauth.v2.access",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "none",
      "scope_parameter": "user_scope",
      "scope_separator": ",",
      "scopes": [
        {
          "values": [
            "channels:read",
            "channels:history",
            "groups:read",
            "groups:history",
            "im:read",
            "im:history",
            "mpim:read",
            "mpim:history",
            "users:read",
            "search:read",
            "files:read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "chat:write",
            "files:write",
            "im:write",
            "mpim:write",
            "reactions:write"
          ]
        }
      ],
      "token_response": {
        "access_token": "/authed_user/access_token",
        "refresh_token": "/authed_user/refresh_token",
        "expires_in": "/authed_user/expires_in",
        "scopes": "/authed_user/scope",
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          },
          {
            "op": "equals",
            "path": "/authed_user/token_type",
            "value": "user"
          },
          {
            "op": "exists",
            "path": "/team/id"
          },
          {
            "op": "exists",
            "path": "/authed_user/id"
          }
        ]
      },
      "refresh_response": {
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          }
        ]
      },
      "account": {
        "url": "https://slack.com/api/auth.test",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/team",
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          }
        ]
      }
    }
  },
  "publisher": {
    "client_id": {
      "label": "Slack client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "Slack client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/auth.test",
          "/api/users.conversations",
          "/api/conversations.info",
          "/api/conversations.history",
          "/api/conversations.replies",
          "/api/conversations.members",
          "/api/search.messages",
          "/api/users.info",
          "/api/users.list",
          "/api/chat.getPermalink",
          "/api/files.info"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "match": {
        "protocol": "http",
        "host": [
          "files.slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/files-pri/*"
        ],
        "opaque_path_parameters": [
          "*"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/chat.postMessage",
          "/api/chat.update",
          "/api/chat.delete",
          "/api/conversations.open",
          "/api/reactions.add",
          "/api/reactions.remove",
          "/api/files.getUploadURLExternal",
          "/api/files.completeUploadExternal"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "files.slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/v1/*"
        ],
        "opaque_path_parameters": [
          "*"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ]
        }
      }
    }
  ]
}
