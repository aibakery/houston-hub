{
  "schema_version": 1,
  "id": "slack",
  "name": "Slack",
  "description": "Read channels, threads, and mentions. Post messages and files as yourself.",
  "setup": "Houston needs authorization in each Slack workspace you connect. Depending on your Slack workspace’s app policy, a workspace admin may need to approve Houston before you can connect your account. Tokens stay on this server. Each connector connects one workspace. Add another connector for each additional workspace.",
  "auth": {
    "type": "oauth2",
    "oauth": {
      "authorize_url": "https://slack.com/oauth/v2/authorize",
      "token_url": "https://slack.com/api/oauth.v2.access",
      "token_path": "authed_user.access_token",
      "refresh_token_path": "authed_user.refresh_token",
      "expires_in_path": "authed_user.expires_in",
      "scopes_path": "authed_user.scope",
      "scope_parameter": "user_scope",
      "scope_separator": ",",
      "required": {
        "ok": "true",
        "authed_user.token_type": "user",
        "team.id": "*",
        "authed_user.id": "*",
        "is_enterprise_install": "false"
      },
      "config": {
        "team_id": "team.id",
        "team_name": "team.name",
        "user_id": "authed_user.id"
      },
      "account_path": "team.name",
      "write_scopes": [
        "chat:write",
        "files:write",
        "im:write",
        "mpim:write",
        "reactions:write"
      ],
      "authorization_inputs": {
        "team": "team.id"
      },
      "client_id": "{{CLIENT_ID}}",
      "client_secret": "{{CLIENT_SECRET}}"
    }
  },
  "access": [
    {
      "id": "read-only",
      "label": "Read-only",
      "scopes": [
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "im:read",
        "im:history",
        "mpim:read",
        "mpim:history",
        "users:read",
        "search:read",
        "files:read",
        "reactions:read"
      ]
    },
    {
      "id": "read-write",
      "label": "Read-write",
      "scopes": [
        "channels:read",
        "channels:history",
        "groups:read",
        "groups:history",
        "im:read",
        "im:history",
        "mpim:read",
        "mpim:history",
        "users:read",
        "search:read",
        "files:read",
        "reactions:read",
        "chat:write",
        "files:write",
        "im:write",
        "mpim:write",
        "reactions:write"
      ]
    }
  ],
  "proxy": {
    "protocol": "http",
    "routes": [
      {
        "hosts": [
          "slack.com"
        ],
        "paths": [
          "/api/auth.test",
          "/api/users.conversations",
          "/api/conversations.info",
          "/api/conversations.history",
          "/api/conversations.replies",
          "/api/conversations.members",
          "/api/search.messages",
          "/api/users.info",
          "/api/users.list",
          "/api/files.info",
          "/api/chat.getPermalink",
          "/api/reactions.get"
        ],
        "methods": [
          "GET"
        ],
        "access": "read",
        "auth": true
      },
      {
        "hosts": [
          "slack.com"
        ],
        "paths": [
          "/api/chat.postMessage",
          "/api/chat.update",
          "/api/chat.delete",
          "/api/conversations.open",
          "/api/reactions.add",
          "/api/reactions.remove",
          "/api/files.completeUploadExternal"
        ],
        "methods": [
          "POST"
        ],
        "access": "write",
        "auth": true
      },
      {
        "hosts": [
          "slack.com"
        ],
        "paths": [
          "/api/files.getUploadURLExternal"
        ],
        "methods": [
          "GET"
        ],
        "access": "write",
        "auth": true
      },
      {
        "hosts": [
          "files.slack.com"
        ],
        "paths": [
          "/files-pri/*"
        ],
        "methods": [
          "GET"
        ],
        "access": "read",
        "auth": true
      },
      {
        "hosts": [
          "files.slack.com"
        ],
        "paths": [
          "/upload/v1/*"
        ],
        "methods": [
          "POST"
        ],
        "access": "write",
        "auth": false
      }
    ]
  },
  "icon": "icon.svg"
}
