{
  "auth": {
    "oauth": {
      "account": {
        "bindings": {
          "team": "/team_id"
        },
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          }
        ],
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/team",
        "method": "GET",
        "url": "https://slack.com/api/auth.test"
      },
      "authorize_params": {
        "team": "{{config.workspace_id}}"
      },
      "authorize_url": "https://slack.com/oauth/v2/authorize",
      "client_auth": "body",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "label": "Connect account",
      "pkce": "none",
      "refresh_response": {
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          }
        ]
      },
      "scope_parameter": "user_scope",
      "scope_separator": ",",
      "scopes": [
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "channels:read",
            "channels:history",
            "groups:read",
            "groups:history",
            "im:read",
            "im:history",
            "mpim:read",
            "mpim:history",
            "users:read",
            "search:read",
            "files:read",
            "reactions:read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "channels:read",
            "channels:history",
            "groups:read",
            "groups:history",
            "im:read",
            "im:history",
            "mpim:read",
            "mpim:history",
            "users:read",
            "search:read",
            "files:read",
            "reactions:read",
            "chat:write",
            "files:write",
            "im:write",
            "mpim:write",
            "reactions:write"
          ]
        }
      ],
      "token_response": {
        "access_token": "/authed_user/access_token",
        "checks": [
          {
            "op": "equals",
            "path": "/ok",
            "value": true
          },
          {
            "op": "equals",
            "path": "/authed_user/token_type",
            "value": "user"
          },
          {
            "op": "equals",
            "path": "/is_enterprise_install",
            "value": false
          },
          {
            "op": "exists",
            "path": "/team/id"
          },
          {
            "op": "exists",
            "path": "/authed_user/id"
          }
        ],
        "expires_in": "/authed_user/expires_in",
        "refresh_token": "/authed_user/refresh_token",
        "scopes": "/authed_user/scope"
      },
      "token_url": "https://slack.com/api/oauth.v2.access",
      "type": "oauth2"
    }
  },
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    },
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    },
    "workspace_id": {
      "description": "Workspace ID beginning with T, available in your Slack workspace URL. Consent must return this workspace.",
      "label": "Slack workspace ID",
      "order": 2,
      "required": true,
      "type": "string"
    }
  },
  "description": "Read channels, threads, and mentions. Post messages and files as yourself.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Slack",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "files.slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/files-pri/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ]
        }
      },
      "match": {
        "host": [
          "files.slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/upload/v1/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "slack.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/auth.test",
          "/api/users.conversations",
          "/api/conversations.info",
          "/api/conversations.history",
          "/api/conversations.replies",
          "/api/conversations.members",
          "/api/search.messages",
          "/api/users.info",
          "/api/users.list",
          "/api/files.info",
          "/api/chat.getPermalink",
          "/api/reactions.get",
          "/api/files.getUploadURLExternal"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "slack.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/chat.postMessage",
          "/api/chat.update",
          "/api/chat.delete",
          "/api/conversations.open",
          "/api/reactions.add",
          "/api/reactions.remove",
          "/api/files.completeUploadExternal"
        ],
        "protocol": "http"
      }
    }
  ],
  "schema_version": 1,
  "setup": "Create an OAuth application with your provider and enter its client ID and client secret in this connection's settings. Copy the OAuth callback URL shown here into that application's allowed redirect URLs before authorizing. Every Houston connection gets a different callback URL; reauthorizing the same connection keeps it. Houston needs authorization in each Slack workspace you connect. Depending on your Slack workspace’s app policy, a workspace admin may need to approve Houston before you can connect your account. Tokens stay on this server. Each connector connects one workspace. Add another connector for each additional workspace."
}
