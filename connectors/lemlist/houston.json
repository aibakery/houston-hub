{
  "schema_version": 2,
  "name": "lemlist",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "auth": {
    "api_key": {
      "type": "manual",
      "label": "API key",
      "config": {
        "token": {
          "label": "API key",
          "required": true,
          "type": "secret"
        }
      }
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/activities",
          "/api/campaigns",
          "/api/campaigns/reports",
          "/api/campaigns/{campaignId}",
          "/api/campaigns/{campaignId}/leads",
          "/api/campaigns/{campaignId}/schedules",
          "/api/campaigns/{campaignId}/senders",
          "/api/campaigns/{campaignId}/sequences",
          "/api/campaigns/{campaignId}/statutes",
          "/api/companies",
          "/api/companies/lists",
          "/api/companies/{companyId}",
          "/api/companies/{companyId}/notes",
          "/api/contact-sourcing",
          "/api/contacts",
          "/api/contacts/lists",
          "/api/contacts/{idOrEmail}",
          "/api/contacts/{idOrEmail}/notes",
          "/api/crm/filters",
          "/api/database/filters",
          "/api/database/personas",
          "/api/database/saved-searches",
          "/api/database/saved-searches/{savedSearchId}",
          "/api/deliverability/alerts",
          "/api/deliverability/alerts/{alertId}",
          "/api/deliverability/incidents",
          "/api/enrich/{enrichId}",
          "/api/fields",
          "/api/hooks",
          "/api/inbox",
          "/api/inbox/labels",
          "/api/inbox/labels/{labelId}",
          "/api/inbox/{contactId}",
          "/api/inbox/{contactId}/drafts",
          "/api/inbox/{contactId}/drafts/{draftId}",
          "/api/leads",
          "/api/message-templates",
          "/api/message-templates/tags",
          "/api/message-templates/{templateId}",
          "/api/schedules",
          "/api/schedules/{scheduleId}",
          "/api/sender-picture/mailboxes",
          "/api/senders",
          "/api/sequences/{sequenceId}/steps/{stepId}/ab-test",
          "/api/sequences/{sequenceId}/steps/{stepId}/branches",
          "/api/sequences/{sequenceId}/steps/{stepId}/sender",
          "/api/snippets",
          "/api/snippets/{snippetId}",
          "/api/team/credits",
          "/api/team/crmUsers",
          "/api/team/senders",
          "/api/user/channels",
          "/api/users/{userId}",
          "/api/v2/campaigns/{campaignId}/stats",
          "/api/v2/enrichments/providers",
          "/api/v2/enrichments/waterfalls",
          "/api/v2/enrichments/waterfalls/{waterfallId}",
          "/api/v2/tasks",
          "/api/v2/tasks/filters",
          "/api/v2/unsubscribes/contacts/{contactId}",
          "/api/v2/unsubscribes/variables",
          "/api/v2/unsubscribes/variables/{value}",
          "/api/warmup/errors",
          "/api/warmup/{userMailboxId}/settings",
          "/api/watchlist",
          "/api/watchlist/filter-values",
          "/api/watchlist/filters",
          "/api/watchlist/history",
          "/api/watchlist/library",
          "/api/watchlist/signals"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    },
    {
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/database/companies",
          "/api/database/people",
          "/api/v2/campaigns/stats/batch"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/api/team"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/api/campaigns",
          "/api/campaigns/{campaignId}/duplicate",
          "/api/campaigns/{campaignId}/leads",
          "/api/campaigns/{campaignId}/leads/import",
          "/api/campaigns/{campaignId}/leads/{leadIdOrEmail}/interested",
