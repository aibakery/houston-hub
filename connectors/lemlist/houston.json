          "/api/campaigns/{campaignId}/senders",
          "/api/campaigns/{campaignId}/start",
          "/api/campaigns/{campaignId}/steps/{stepId}/skip",
          "/api/campaigns/{campaignId}/steps/{stepId}/skip-for-leads",
          "/api/campaigns/{campaignId}/triggers/watch-lists",
          "/api/companies",
          "/api/companies/lists",
          "/api/companies/lists/{listId}/entities",
          "/api/companies/merge",
          "/api/companies/{companyId}/notes",
          "/api/contact-sourcing",
          "/api/contact-sourcing/contacts",
          "/api/contacts",
          "/api/contacts/lists",
          "/api/contacts/lists/{listId}/entities",
          "/api/contacts/merge",
          "/api/contacts/{idOrEmail}/notes",
          "/api/database/personas",
          "/api/database/saved-searches",
          "/api/deliverability/alerts",
          "/api/enrich",
          "/api/hooks",
          "/api/inbox/conversations/labels/{contactId}",
          "/api/inbox/email",
          "/api/inbox/labels",
          "/api/inbox/linkedin",
          "/api/inbox/sms",
          "/api/inbox/whatsapp",
          "/api/inbox/{contactId}/drafts",
          "/api/leads/interested/{leadIdOrEmail}",
          "/api/leads/notinterested/{leadIdOrEmail}",
          "/api/leads/pause/{leadId}",
          "/api/leads/review/{leadId}",
          "/api/leads/start/{leadId}",
          "/api/leads/{leadId}/enrich",
          "/api/leads/{leadId}/variables",
          "/api/schedules",
          "/api/sender-picture/sync",
          "/api/sequences/{sequenceId}/steps",
          "/api/sequences/{sequenceId}/steps/{stepId}/ab-test",
          "/api/sequences/{sequenceId}/steps/{stepId}/ab-test/winner",
          "/api/sequences/{sequenceId}/steps/{stepId}/branches",
          "/api/tasks",
          "/api/tasks/ignore",
          "/api/user/email-accounts/{emailAccountId}/test",
          "/api/v2/enrichments/bulk",
          "/api/v2/unsubscribes/contacts/{contactId}",
          "/api/v2/unsubscribes/variables",
          "/api/v2/unsubscribes/variables/{value}",
