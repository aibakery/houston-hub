          "/api/warmup/{userMailboxId}/start",
          "/api/watchlist",
          "/api/watchlist/crm-lists",
          "/api/watchlist/{watchListId}/external-signals"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/api/campaigns/{campaignId}/leads/{leadIdOrEmail}/steps/{stepId}/personalization",
          "/api/campaigns/{campaignId}/senders",
          "/api/sequences/{sequenceId}/steps/{stepId}/sender",
          "/api/v2/enrichments/waterfalls/{waterfallId}/reset",
          "/api/watchlist/signals"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "PATCH"
        ],
        "path": [
          "/api/campaigns/{campaignId}",
          "/api/campaigns/{campaignId}/leads/{leadId}",
          "/api/campaigns/{campaignId}/senders/{userId}",
          "/api/database/saved-searches/{savedSearchId}",
          "/api/deliverability/alerts/{alertId}",
          "/api/inbox/{contactId}/drafts/{draftId}",
          "/api/leads/{leadId}/variables",
          "/api/schedules/{scheduleId}",
          "/api/sequences/{sequenceId}/steps/{stepId}",
          "/api/sequences/{sequenceId}/steps/{stepId}/ab-test",
          "/api/sequences/{sequenceId}/steps/{stepId}/branches",
          "/api/sequences/{sequenceId}/steps/{stepId}/branches/{branchSequenceId}",
          "/api/tasks",
          "/api/users/{userId}/linkedin-limits",
          "/api/v2/enrichments/waterfalls/{waterfallId}",
          "/api/warmup/{userMailboxId}/settings",
          "/api/watchlist"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    },
    {
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "api.lemlist.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/api/activities/{activityId}/recording-transcript",
          "/api/campaigns/{campaignId}/leads/{leadIdOrEmail}",
          "/api/campaigns/{campaignId}/leads/{leadIdOrEmail}/steps/{stepId}/personalization",
          "/api/campaigns/{campaignId}/senders/{userId}",
          "/api/campaigns/{campaignId}/triggers/watch-lists/{watchListId}",
          "/api/companies/{companyId}",
          "/api/contacts/{idOrEmail}",
          "/api/database/personas/{personaId}",
          "/api/database/saved-searches/{savedSearchId}",
          "/api/deliverability/alerts/{alertId}",
          "/api/hooks/{hookId}",
          "/api/inbox/conversations/labels/{contactId}",
          "/api/inbox/{contactId}/drafts/{draftId}",
          "/api/leads/{leadId}/variables",
          "/api/schedules/{scheduleId}",
          "/api/sequences/{sequenceId}/steps/{stepId}",
          "/api/sequences/{sequenceId}/steps/{stepId}/ab-test",
          "/api/sequences/{sequenceId}/steps/{stepId}/branches/{branchSequenceId}",
          "/api/sequences/{sequenceId}/steps/{stepId}/sender",
          "/api/user/email-accounts/{emailAccountId}",
          "/api/v2/enrichments/providers/{providerId}/connection",
          "/api/v2/unsubscribes/contacts/{contactId}",
          "/api/v2/unsubscribes/variables/{value}",
          "/api/watchlist"
        ]
      },
      "action": {
        "basic_auth": {
          "username": "",
          "password": "{{auth.api_key.token}}"
        }
      }
    }
  ]
}
