{
  "connection_label": [
    {
      "value": "{{config.host}} / {{config.database}}"
    }
  ],
  "access": [
    {
      "default": "read",
      "label": "Access",
      "levels": [
        {
          "label": "Read",
          "value": "read"
        },
        {
          "label": "Write",
          "value": "write"
        }
      ],
      "name": "data"
    }
  ],
  "config": {
    "database": {
      "label": "Database",
      "order": 3,
      "required": true,
      "type": "string"
    },
    "host": {
      "label": "Host",
      "order": 2,
      "required": true,
      "type": "string"
    },
    "password": {
      "label": "Password",
      "order": 5,
      "required": true,
      "type": "secret"
    },
    "port": {
      "default": 5432,
      "label": "Port",
      "maximum": 65535,
      "minimum": 1,
      "order": 3,
      "type": "integer"
    },
    "username": {
      "label": "Username",
      "order": 4,
      "required": true,
      "type": "string"
    }
  },
  "description": "SQL access to your Supabase Postgres database.",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "name": "Supabase",
  "proxy": [
    {
      "action": {
        "connection": {
          "database": "{{config.database}}",
          "host": "{{config.host}}",
          "password": "{{config.password}}",
          "port": "{{config.port}}",
          "tls": {
            "mode": "verify-full"
          },
          "user": "{{config.username}}"
        }
      },
      "match": {
        "protocol": "postgres"
      }
    }
  ],
  "schema_version": 2
}
