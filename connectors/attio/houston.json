{
  "auth": {
    "token": {
      "config": {
        "token": {
          "label": "API key",
          "required": true,
          "type": "secret"
        }
      },
      "label": "API key",
      "type": "manual"
    }
  },
  "description": "Read-only access to Attio objects, records, and notes.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.png",
  "name": "Attio",
  "proxy": [
    {
      "origins": {
        "https://api.attio.com": {
          "allowlist": [
            {
              "methods": [
                "POST"
              ],
              "paths": [
                "/v2/objects/{object}/records/query",
                "/v2/objects/records/search",
                "/v2/lists/{list}/entries/query"
              ]
            },
            {
              "methods": [
                "GET",
                "HEAD"
              ],
              "paths": [
                "/v2/*"
              ]
            }
          ],
          "headers": {
            "Authorization": {
              "value": "Bearer {{auth.token.token}}"
            }
          }
        }
      },
      "protocol": "http"
    }
  ],
  "schema_version": 1,
  "setup": "The API key stays on this server. Houston reads CRM data from Attio; your records stay in Attio."
}
