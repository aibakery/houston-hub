{
  "auth": {
    "token": {
      "config": {
        "token": {
          "label": "API key",
          "required": true,
          "type": "secret"
        }
      },
      "label": "API key",
      "type": "manual"
    }
  },
  "description": "Read-only access to Attio objects, records, and notes.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.png",
  "name": "Attio",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.attio.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/v2/objects/{object}/records/query",
          "/v2/objects/records/search",
          "/v2/lists/{list}/entries/query"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.token.token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.attio.com"
        ],
        "method": [
          "GET",
          "HEAD"
        ],
        "path": [
          "/v2/*"
        ],
        "protocol": "http"
      }
    }
  ],
  "schema_version": 1,
  "setup": "The API key stays on this server. Houston reads CRM data from Attio; your records stay in Attio."
}
