										"enum": [
											"option_grant",
											"certificate"
										],
										"example": "option_grant",
										"type": "string"
									},
									"stockOptionType": {
										"description": "Which tax pool of an option grant is being sold, uppercase on the wire: \"ISO\" or \"NSO\". Option grants only; rejected for a certificate. Required when the grant is an ISO/NSO split, optional otherwise. Absent for a certificate.",
										"example": "NSO",
										"type": "string"
									},
									"taxReference": {
										"description": "The tax reference for an option grant, present once the issuer has approved option cost. Absent while the transaction is `PENDING_ISSUER_OPTION_COST_REVIEW`: until the issuer approves, the withholding is only an estimate the issuer can still change. In `PENDING_SETTLEMENT`, `TRANSACTION_CREATED`, `SETTLING` and `SETTLED` it is the final withholding the issuer approved and Carta settles with. A `CANCELED` transaction carries it only if the issuer approved option cost before cancellation. Always absent for a certificate line.",
										"properties": {
