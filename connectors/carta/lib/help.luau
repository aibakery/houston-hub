										},
										"readOnly": true,
										"title": "v1alpha1Iso8601CompleteCalendarDate",
										"type": "object"
									},
									"newCertificateId": {
										"description": "The new certificate issued to the buyer. Populated once the transaction reaches SETTLED. Absent for a line that has not settled, and for a full repurchase, which yields no resulting security.",
										"example": "901234",
