{
  "schema_version": 1,
  "name": "Microsoft OneDrive",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "type": "string",
      "label": "Access",
      "default": "read-only",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ]
    }
  },
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Microsoft",
      "brand": "microsoft",
      "authorize_url": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
      "token_url": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "S256",
      "require_refresh": true,
      "authorize_params": {
        "prompt": "select_account"
      },
      "scopes": [
        {
          "values": [
            "offline_access",
            "User.Read"
          ]
        },
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "Files.Read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "Files.ReadWrite"
          ]
        }
      ],
      "account": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me?$select=userPrincipalName",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/userPrincipalName"
      },
      "token_response": {
        "scopes_unreported": true,
        "checks": [
          {
            "op": "equals",
            "path": "/token_type",
            "value": "Bearer"
          },
          {
            "op": "exists",
            "path": "/refresh_token"
          }
        ]
      }
    }
  },
  "publisher": {
    "client_id": {
      "type": "string",
      "label": "Microsoft application (client) ID",
      "required": true,
      "order": 1
    },
    "client_secret": {
      "type": "secret",
      "label": "Microsoft client secret value",
      "required": true,
      "order": 2
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/v1.0/me/drive",
          "/v1.0/me/drive/root",
          "/v1.0/me/drive/root/children",
          "/v1.0/me/drive/root/{search}",
          "/v1.0/me/drive/root:/*",
          "/v1.0/me/drive/items/{itemId}",
          "/v1.0/me/drive/items/{itemId}/children",
          "/v1.0/me/drive/items/{itemId}/content",
          "/v1.0/me/drive/items/{itemId}/permissions",
          "/v1.0/drives/{driveId}/root/children",
          "/v1.0/drives/{driveId}/root/{search}",
          "/v1.0/drives/{driveId}/items/{itemId}/children"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/v1.0/me/drive/root/children",
          "/v1.0/me/drive/items/{itemId}/children",
          "/v1.0/me/drive/items/{itemId}/copy",
          "/v1.0/me/drive/items/{itemId}/createLink",
          "/v1.0/me/drive/items/{itemId}/invite"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PATCH",
          "DELETE"
        ],
        "path": [
          "/v1.0/me/drive/items/{itemId}"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/v1.0/me/drive/items/{itemId}/permissions/{permissionId}"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/v1.0/me/drive/items/{itemId}/content"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/v1.0/me/drive/root:/{fileName}/content"
        ],
        "colon_path_parameters": [
          "fileName"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/v1.0/me/drive/items/{parentId}/{fileName}/content"
        ],
        "colon_path_parameters": [
          "parentId",
          "fileName"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "match": {
        "protocol": "http",
        "host": [
          "*.sharepoint.com",
          "*.files.1drv.com",
          "*.livefilestore.com",
          "my.microsoftpersonalcontent.com",
          "*.svc.ms"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/*"
        ],
        "opaque_path_parameters": [
          "*"
        ]
      },
      "action": {
        "headers": {
          "remove": [
            "Authorization"
          ]
        }
      }
    }
  ]
}
