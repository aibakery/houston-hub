{
  "schema_version": 1,
  "name": "Microsoft Excel",
  "warning": "**Work or school accounts only.** Microsoft's Excel API does not support workbooks in a personal OneDrive, so Outlook.com and other personal Microsoft accounts cannot connect.",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "type": "string",
      "label": "Access",
      "default": "read-only",
      "description": "Read and write lets agents create workbooks, change cells and formulas, insert and delete cells or rows, add table rows and tables, and add, rename, hide or delete worksheets; changes are saved to the file in OneDrive. To create workbooks it can also write a file by name in your OneDrive, which could replace a file with that name.",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ]
    }
  },
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Microsoft",
      "brand": "microsoft",
      "authorize_url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/authorize",
      "token_url": "https://login.microsoftonline.com/organizations/oauth2/v2.0/token",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "client_auth": "body",
      "pkce": "S256",
      "require_refresh": true,
      "authorize_params": {
        "prompt": "select_account"
      },
      "scopes": [
        {
          "values": [
            "offline_access",
            "User.Read"
          ]
        },
        {
          "if": "{{ is config.access \"read-only\" }}",
          "values": [
            "Files.Read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "Files.ReadWrite"
          ]
        }
      ],
      "account": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me?$select=userPrincipalName",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/userPrincipalName"
      },
      "token_response": {
        "scopes_unreported": true,
        "checks": [
          {
            "op": "equals",
            "path": "/token_type",
            "value": "Bearer"
          },
          {
            "op": "exists",
            "path": "/refresh_token"
          }
        ]
      }
    }
  },
  "publisher": {
    "client_id": {
      "type": "string",
      "label": "Microsoft application (client) ID",
      "required": true,
      "order": 1
    },
    "client_secret": {
      "type": "secret",
      "label": "Microsoft client secret value",
      "required": true,
      "order": 2
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/v1.0/me/drive/root/{search}",
          "/v1.0/drives/{driveId}/root/{search}",
          "/v1.0/me/drive/items/{itemId}",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}/{range}",
          "/v1.0/me/drive/items/{itemId}/workbook/tables",
          "/v1.0/me/drive/items/{itemId}/workbook/tables/{table}/range",
          "/v1.0/me/drive/items/{itemId}/workbook/names",
          "/v1.0/me/drive/items/{itemId}/workbook/names/{name}/range"
        ],
        "colon_path_parameters": [
          "search",
          "range"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/v1.0/me/drive/items/{itemId}/workbook/createSession",
          "/v1.0/me/drive/items/{itemId}/workbook/closeSession",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/add",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}/tables/add",
          "/v1.0/me/drive/items/{itemId}/workbook/tables/{table}/rows/add",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}/{range}/clear",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}/{range}/insert",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}/{range}/delete",
          "/v1.0/me/drive/items/{itemId}/workbook/names/{name}/range/clear",
          "/v1.0/me/drive/items/{itemId}/workbook/names/{name}/range/insert",
          "/v1.0/me/drive/items/{itemId}/workbook/names/{name}/range/delete"
        ],
        "colon_path_parameters": [
          "range"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/v1.0/me/drive/root:/{fileName}/content"
        ],
        "colon_path_parameters": [
          "fileName"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PUT"
        ],
        "path": [
          "/v1.0/me/drive/items/{parentId}/{fileName}/content"
        ],
        "colon_path_parameters": [
          "parentId",
          "fileName"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "PATCH"
        ],
        "path": [
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}",
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}/{range}",
          "/v1.0/me/drive/items/{itemId}/workbook/names/{name}/range"
        ],
        "colon_path_parameters": [
          "range"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    },
    {
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "protocol": "http",
        "host": [
          "graph.microsoft.com"
        ],
        "method": [
          "DELETE"
        ],
        "path": [
          "/v1.0/me/drive/items/{itemId}/workbook/worksheets/{worksheet}"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    }
  ]
}
