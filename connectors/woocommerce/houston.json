{
  "connection_label": [
    {
      "value": "{{config.store_host}}"
    }
  ],
  "schema_version": 2,
  "name": "WooCommerce",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "data",
      "label": "Access",
      "levels": [
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "config": {
    "store_host": {
      "description": "The domain your store is served from, without https:// or a path.",
      "label": "Store domain",
      "max_length": 253,
      "order": 2,
      "placeholder": "shop.example.com",
      "required": true,
      "type": "string"
    }
  },
  "auth": {
    "keys": {
      "config": {
        "consumer_key": {
          "label": "Consumer key",
          "order": 1,
          "required": true,
          "type": "secret"
        },
        "consumer_secret": {
          "label": "Consumer secret",
          "order": 2,
          "required": true,
          "type": "secret"
        }
      },
      "label": "WooCommerce REST API key",
      "type": "manual"
    }
  },
  "proxy": [
    {
      "action": {
        "basic_auth": {
          "password": "{{auth.keys.consumer_secret}}",
          "username": "{{auth.keys.consumer_key}}"
        }
      },
      "if": "{{ allows access.data \"write\" }}",
      "match": {
        "host": [
          "{{config.store_host}}"
        ],
        "method": [
          "GET",
          "POST",
          "PUT",
          "DELETE"
        ],
        "path": [
          "/wp-json/wc/v3/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "basic_auth": {
          "password": "{{auth.keys.consumer_secret}}",
          "username": "{{auth.keys.consumer_key}}"
        }
      },
      "match": {
        "host": [
          "{{config.store_host}}"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/wp-json/wc/v3/coupons",
          "/wp-json/wc/v3/coupons/*",
          "/wp-json/wc/v3/customers",
          "/wp-json/wc/v3/customers/*",
          "/wp-json/wc/v3/data/*",
          "/wp-json/wc/v3/orders",
          "/wp-json/wc/v3/orders/*",
          "/wp-json/wc/v3/products",
          "/wp-json/wc/v3/products/*",
          "/wp-json/wc/v3/refunds",
          "/wp-json/wc/v3/reports",
          "/wp-json/wc/v3/reports/*",
          "/wp-json/wc/v3/shipping/*",
          "/wp-json/wc/v3/shipping_methods",
          "/wp-json/wc/v3/shipping_methods/*",
          "/wp-json/wc/v3/system_status",
          "/wp-json/wc/v3/system_status/*",
          "/wp-json/wc/v3/taxes",
          "/wp-json/wc/v3/taxes/*"
        ],
        "protocol": "http"
      }
    }
  ]
}
