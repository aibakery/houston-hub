{
  "schema_version": 1,
  "name": "WooCommerce",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ],
      "order": 1,
      "type": "string"
    },
    "store_host": {
      "description": "The domain your store is served from, without https:// or a path.",
      "label": "Store domain",
      "max_length": 253,
      "order": 2,
      "placeholder": "shop.example.com",
      "required": true,
      "type": "string"
    }
  },
  "auth": {
    "keys": {
      "config": {
        "consumer_key": {
          "label": "Consumer key",
          "order": 1,
          "required": true,
          "type": "secret"
        },
        "consumer_secret": {
          "label": "Consumer secret",
          "order": 2,
          "required": true,
          "type": "secret"
        }
      },
      "label": "WooCommerce REST API key",
      "type": "manual"
    }
  },
  "proxy": [
    {
      "action": {
        "basic_auth": {
          "password": "{{auth.keys.consumer_secret}}",
          "username": "{{auth.keys.consumer_key}}"
        }
      },
      "if": "{{ is config.access \"read-write\" }}",
      "match": {
        "host": [
          "{{config.store_host}}"
        ],
        "method": [
          "GET",
          "POST",
          "PUT",
          "DELETE"
        ],
        "path": [
          "/wp-json/wc/v3/*"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "basic_auth": {
          "password": "{{auth.keys.consumer_secret}}",
          "username": "{{auth.keys.consumer_key}}"
        },
        "headers": {
          "remove": [
            "X-HTTP-Method-Override"
          ]
        }
      },
      "match": {
        "host": [
          "{{config.store_host}}"
        ],
        "method": [
          "GET"
        ],
        "path": [
          "/wp-json/wc/v3/coupons",
          "/wp-json/wc/v3/coupons/*",
          "/wp-json/wc/v3/customers",
          "/wp-json/wc/v3/customers/*",
          "/wp-json/wc/v3/data/*",
          "/wp-json/wc/v3/orders",
          "/wp-json/wc/v3/orders/*",
          "/wp-json/wc/v3/products",
          "/wp-json/wc/v3/products/*",
          "/wp-json/wc/v3/refunds",
          "/wp-json/wc/v3/reports",
          "/wp-json/wc/v3/reports/*",
          "/wp-json/wc/v3/shipping/*",
          "/wp-json/wc/v3/shipping_methods",
          "/wp-json/wc/v3/shipping_methods/*",
          "/wp-json/wc/v3/system_status",
          "/wp-json/wc/v3/system_status/*",
          "/wp-json/wc/v3/taxes",
          "/wp-json/wc/v3/taxes/*"
        ],
        "protocol": "http"
      }
    }
  ]
}
