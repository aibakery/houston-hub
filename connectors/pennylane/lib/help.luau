										"format": "int64",
										"type": "integer"
									},
									"product_id": {
										"anyOf": [
											{
												"description": "The product id for this line.",
												"example": 42,
												"format": "int64",
												"type": "integer"
											},
											{
												"type": "null"
											}
										]
									},
									"quantity": {
