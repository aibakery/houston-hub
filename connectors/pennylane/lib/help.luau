	"createSupplierInvoiceEInvoiceImport": {
		"description": "Import a supplier e-invoice",
		"inputSchema": {
			"allOf": [
				{
					"additionalProperties": false,
					"properties": {
						"content_type": {
							"description": "MIME type; inferred from filename when omitted.",
							"pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$",
							"type": "string"
						},
						"file": {
							"description": "Existing private session file; streamed to Pennylane.",
							"minLength": 1,
							"type": "string"
						},
						"filename": {
							"description": "Plain file name, at most 255 bytes; defaults to the session path basename.",
							"maxLength": 255,
							"minLength": 1,
							"pattern": "^[^\\u0000-\\u001f\\u007f\"/\\\\]+$",
							"type": "string"
						},
						"invoice_options": {
							"additionalProperties": false,
							"description": "Optional JSON payload to enrich the imported supplier invoice.\nInvoice line `e_invoice_line_id` must match Factur-X BT-126 (LineID).\n",
							"properties": {
								"invoice_lines": {
									"items": {
										"additionalProperties": false,
										"properties": {
											"e_invoice_line_id": {
												"description": "Factur-X line identifier (BT-126 LineID).",
												"type": "string"
											},
											"ledger_account_id": {
												"anyOf": [
													{
														"description": "Ledger account id for this line.",
