											"description": "Invoice description. Maximum 5,000 characters.",
											"example": "Invoice description",
											"type": "string"
										},
										{
											"type": "null"
										}
									]
								},
								"pdf_invoice_free_text": {
									"anyOf": [
										{
											"description": "For example, the contact details of the person to contact",
											"example": "Additional free field",
											"type": "string"
										},
										{
											"type": "null"
										}
									]
								},
								"pdf_invoice_subject": {
									"anyOf": [
										{
											"description": "Invoice title",
											"example": "Invoice title",
											"type": "string"
										},
										{
											"type": "null"
										}
									]
								},
								"purchase_order_reference": {
									"anyOf": [
										{
											"description": "Buyer's purchase order reference (e-invoice field BT-13). Maximum 50 characters.",
											"example": "PO-2026-001",
											"maxLength": 50,
											"type": "string"
										},
										{
											"type": "null"
										}
									]
								},
								"sale_type": {
									"description": "Type of sale printed on the invoice (Type de vente).\n`goods` is a supply of goods, `services` is a supply of services,\nand `goods_and_services` is both. `null` means the type has not been chosen.\nThis is not invoice line `substance`.\nOmit this field to keep the invoice template default on create, or to leave\nthe invoice unchanged on update. Send `null` to clear it.\nFinalized invoices cannot be updated with this field.\n",
									"oneOf": [
										{
											"description": "Type of sale printed on a customer invoice. This is not invoice line substance.",
											"enum": [
												"goods",
												"services",
												"goods_and_services"
											],
											"type": "string"
										},
										{
											"anyOf": [
												{
													"enum": [
														null
													],
													"type": "string"
												},
												{
													"type": "null"
												}
											]
										}
									]
								},
								"special_mention": {
									"anyOf": [
										{
											"description": "Additional details. maximum 20,000 characters.",
											"example": "Additional details",
											"type": "string"
										},
										{
											"type": "null"
										}
									]
								},
								"transaction_reference": {
									"additionalProperties": false,
									"description": "By adding this field you can automatically reconcile the newly created invoice with a transaction. See documentation about [automatic payment matching](https://pennylane.readme.io/v2.0/docs/automating-payment-matching).",
									"properties": {
										"banking_provider": {
											"description": "The banking provider for the transaction",
											"enum": [
												"stripe",
												"gocardless",
												"bank",
												"budgetinsight",
												"helloasso"
											],
											"example": "bank",
											"type": "string"
										},
										"provider_field_name": {
											"description": "Name of the field that you want to match",
											"enum": [
												"payment_id",
												"charge_id",
												"report_id",
												"webid",
												"label",
												"order_id"
											],
											"example": "label",
											"type": "string"
										},
										"provider_field_value": {
											"description": "Value that you want to match.\n\nWith `banking_provider: stripe` or `gocardless`, the value is matched exactly against the reference with the same `provider_field_name` synced from that provider, on non-archived transactions.\n\nWith `banking_provider: bank` and `provider_field_name: label`, every non-archived bank transaction whose label contains this value as a whole word is matched, including transactions already matched to other documents. The match is case-sensitive, and a value that does not start and end with a letter, digit or underscore never matches. Use a value that identifies a single payment, such as a card transaction ID: a merchant name or a short generic value groups unrelated documents together. Pass the literal string `invoice_number` to match on this invoice's number instead of a fixed value.\n\nOther combinations do not match any transaction.\n\nIn all cases, matching runs again on every update of this invoice.",
											"example": "invoice_number",
											"type": "string"
										}
									},
									"required": [
										"banking_provider",
										"provider_field_name",
										"provider_field_value"
									],
									"type": "object"
								}
							},
							"required": [
								"date",
								"deadline",
								"customer_id",
								"invoice_lines"
							],
							"title": "Finalized Customer Invoice",
							"type": "object"
						}
					]
				}
			],
			"examples": [
				{
					"customer_id": 42,
					"date": "2026-11-01",
					"deadline": "2026-11-30",
					"draft": true,
					"invoice_lines": [
						{
							"label": "Consulting",
							"quantity": 1,
							"raw_currency_unit_price": "100.00",
							"unit": "piece",
							"vat_rate": "FR_200"
						}
					]
				},
				{
					"customer_id": 42,
					"date": "2026-11-01",
					"deadline": "2026-11-30",
					"draft": true,
					"invoice_lines": [
						{
							"product_id": 7,
							"quantity": 2
						}
					]
				}
			],
			"properties": {},
			"required": [
				"date",
				"deadline",
				"customer_id",
				"invoice_lines"
			],
			"type": "object"
		}
	},
