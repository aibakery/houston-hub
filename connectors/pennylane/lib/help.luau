	"postSepaMandates": {
		"description": "Create a SEPA mandate",
		"inputSchema": {
			"allOf": [
				{
					"additionalProperties": false,
					"properties": {
						"bank": {
							"description": "Name of the customer's bank",
							"example": "BNP Paribas",
							"type": "string"
						},
						"bic": {
							"description": "Bank Identifier Code (BIC) of the customer's bank",
							"example": "BNPAFRPP",
							"type": "string"
						},
						"customer_id": {
							"description": "ID of the customer for which the mandate is created",
							"example": 47334785,
							"format": "int64",
							"type": "integer"
						},
						"iban": {
							"description": "International Bank Account Number (IBAN) of the customer",
							"example": "FR3612739000506556687647Z31",
							"type": "string"
						},
						"identifier": {
							"description": "Unique identifier for the mandate",
							"example": "K-02-2025-12345",
							"type": "string"
						},
						"sequence_type": {
							"default": "RCUR",
							"description": "SEPA mandate sequence type that defines the payment process.\n- `FRST`: First payment in a series of recurring payments\n- `OOFF`: One-off payment\n- `RCUR`: Recurring payment that is not the first payment\n- `FNAL`: Final payment in a series of recurring payments\n",
							"enum": [
								"FRST",
								"OOFF",
								"RCUR",
								"FNAL"
							],
							"example": "RCUR",
							"type": "string"
						},
						"signed_at": {
							"description": "Date when the mandate was signed",
							"example": "2025-04-24",
							"format": "date",
							"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
							"type": "string"
						}
					},
					"required": [
						"bic",
						"iban",
						"signed_at",
						"identifier",
						"customer_id"
					],
					"type": "object"
				}
			],
			"examples": [
				{
					"bic": "BNPAFRPP",
					"customer_id": 47334785,
					"iban": "FR3612739000506556687647Z31",
					"identifier": "K-02-2025-12345",
					"signed_at": "2025-04-24"
				}
			],
			"properties": {},
			"required": [
				"bic",
				"iban",
				"signed_at",
				"identifier",
				"customer_id"
			],
			"type": "object"
		}
	},
