	"postQuoteAppendices": {
		"description": "Upload an appendix for a quote",
		"inputSchema": {
			"allOf": [
				{
					"additionalProperties": false,
					"properties": {
						"content_type": {
							"description": "MIME type; inferred from filename when omitted.",
							"pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$",
							"type": "string"
						},
						"file": {
							"description": "Existing private session file; streamed to Pennylane.",
							"minLength": 1,
							"type": "string"
						},
						"filename": {
							"description": "Plain file name, at most 255 bytes; defaults to the session path basename.",
							"maxLength": 255,
							"minLength": 1,
							"pattern": "^[^\\u0000-\\u001f\\u007f\"/\\\\]+$",
							"type": "string"
						},
						"quote_id": true
					},
					"required": [
						"file"
					],
					"type": "object"
				}
			],
			"examples": [
				{
					"file": "invoice.pdf",
					"quote_id": 42
				}
			],
			"properties": {
				"quote_id": {
					"anyOf": [
						{
							"maximum": 9007199254740991,
							"minimum": 0,
							"type": "integer"
						},
						{
							"pattern": "^[0-9]{1,19}$",
							"type": "string"
						}
					],
					"description": "Nonnegative numeric ID (safe integers) or up to 19 decimal digits."
				}
			},
			"required": [
				"quote_id"
			],
			"type": "object"
		}
	},
