							},
							"type": "object"
						},
						"override_invoice_lines": {
							"description": "Complete set of accounting lines that **replaces** the ones produced by the\nFactur-X parser. When provided, the parser's lines are discarded and the invoice is\nbuilt from these lines instead; the document total is still read from the file for a\ncoherence check. If the lines do not reconcile with the Factur-X total, the override\nis ignored and the parsed Factur-X lines are kept.\n\nMutually exclusive with `invoice_options.invoice_lines` (sending both returns 400).\n",
							"items": {
								"additionalProperties": false,
								"description": "A complete accounting line used to override the Factur-X invoice lines.\nLines absent from the XML (e.g. a down-payment deduction, a reverse-charge line)\nare expressed directly here — a TTC deduction is a normal line with a negative\n`currency_amount`.\n",
								"properties": {
									"currency_amount": {
										"allOf": [
											{
												"example": "100.00",
												"pattern": "^(-?\\d+(\\.\\d+)?)?$",
												"type": "string"
											},
											{
												"description": "Line total amount excluding tax, in the invoice currency. May be negative.",
												"example": "50.00"
											}
										]
									},
									"currency_tax": {
										"allOf": [
											{
												"example": "100.00",
