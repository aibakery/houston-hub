									},
									{
										"if": {
											"properties": {
												"operator": {
													"enum": [
														"last_x"
													]
												}
											},
											"required": [
												"operator"
											]
										},
										"then": {
											"properties": {
												"value": {
													"pattern": "^[0-9]+ (days|weeks|months|years)$",
													"type": "string"
												}
											}
										}
									}
								],
								"properties": {
									"field_id": {
										"description": "Field ID to filter on. Use the corresponding List Fields endpoint to discover valid IDs.",
										"type": "string"
									},
									"operator": {
										"description": "Comparison operator. \"between\" requires a two-element array value. \"blank\" / \"not_blank\" take no value and match records where the field is unset / has a value (to exclude blanks, use \"not_blank\" — \"neq\" with an empty value does not). In saved reports \"not_blank\" is rejected on any field whose report column is a set filter (fields with a fixed list of values, such as stage, dropdown, multi-select, checkbox and user-list fields); \"blank\" works on every field. \"last_x\" requires a DATE field and rolls a relative window forward on every request (e.g. \"the last 12 months, as of right now\") rather than freezing an absolute range.",
										"enum": [
											"eq",
											"neq",
											"gt",
											"gte",
											"lt",
											"lte",
											"contains",
											"in",
											"between",
											"last_x",
											"blank",
											"not_blank"
										],
										"type": "string"
									},
									"value": {
										"description": "Filter value; required for every operator except \"blank\" / \"not_blank\". For \"in\": string array. For \"between\": [from, to] array. For \"last_x\": a string of the form \"\u003ccount\u003e \u003cunit\u003e\" (e.g. \"12 months\", \"30 days\"); units are days, weeks, months, or years.",
										"oneOf": [
											{
												"type": "string"
											},
											{
												"type": "number"
											},
											{
												"type": "boolean"
											},
											{
												"items": {
													"type": "string"
												},
												"type": "array"
											}
										]
									}
								},
								"required": [
									"field_id",
									"operator"
								],
								"title": "PublicFilterDto",
								"type": "object"
							},
							"type": "array"
						},
						"group_by": {
							"description": "Field ID to group by, wrapped in a single-element array. Only one field at a time is supported. Use the corresponding List Fields endpoint to discover valid IDs.",
							"items": {
								"type": "string"
							},
							"maxItems": 1,
							"minItems": 1,
							"type": "array"
						},
						"group_by_granularity": {
							"description": "Optional time-bucket granularity. Only valid when `group_by` targets a single DATE field — buckets its value into calendar day/week/month/quarter/year instead of grouping by each distinct raw timestamp (which otherwise returns one group per millisecond-precise value, capped at 10,000 groups and sorted by count, not chronologically). Result groups are keyed by a plain bucket label (e.g. \"2026-07\" for month) — NOT the field's usual grouped-path shape — so reference the bucket key directly in a `transform`, never the field's own path. Buckets with zero matching records in the observed date range are still included with `count: 0`, so a time-series chart has no gaps. Bucket boundaries are computed in UTC regardless of the viewer's timezone — a rolling window from a `last_x` filter on the same field IS timezone-aware, so its edges may not land exactly on a UTC bucket boundary. `week` buckets start on Monday and are labelled by that Monday's date (e.g. \"2026-07-06\").",
							"enum": [
								"day",
								"week",
								"month",
								"quarter",
								"year"
							],
							"type": "string"
						},
						"metric": {
							"description": "Optional numeric aggregation on top of the always-present per-group `count`. `field_id` must be a NUMBER or FORMULA field; `agg_func` is one of sum, avg, min, max. Each group then also carries `metricValue` (the aggregation over that group), and the response carries `metricTotal` (the same aggregation across all groups) for sum, min and max — `metricTotal` is omitted for avg, because per-group averages cannot be recombined into an overall average. Use this for \"total/average \u003camount\u003e by \u003cfield\u003e\" questions instead of summing search results, which are page-limited. A value stored as text is parsed as a number; a value that is blank or unparseable is ignored (it does not count as 0), and a group with no usable value at all reports `metricValue: 0`.",
							"properties": {
								"agg_func": {
									"description": "How to aggregate `field_id` within each group.",
									"enum": [
										"sum",
										"avg",
										"min",
										"max"
									],
									"type": "string"
								},
								"field_id": {
									"description": "Field ID to aggregate. Must be a NUMBER or FORMULA field.",
									"type": "string"
								}
							},
							"required": [
								"field_id",
								"agg_func"
							],
							"title": "PublicAggregateMetricDto",
							"type": "object"
						}
					},
					"required": [
						"group_by"
					],
					"title": "PublicAggregateRequestDto",
					"type": "object"
				}
			],
			"examples": [
				{
					"group_by": [
						"65a1b2c3d4e5f60718293a4d"
					]
				}
			],
			"properties": {},
			"required": [
				"group_by"
			],
			"type": "object"
		}
	},
