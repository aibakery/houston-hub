	"createFundraising": {
		"description": "Creates a new fundraising record in the specified stage. The fundraising will be associated with the authenticated organization.\n\n**Auto-Enrichment:** To enable automatic company data enrichment, provide a valid company website URL in the `fields.website` field. When a valid URL is supplied, the system will automatically populate additional company information.\n\n**Origin contact link:** When `originContactId` is provided, the referenced contact must already exist in the caller's organization (request fails with 404 otherwise). The fundraising's `name` and `image` are set from the contact's `name` and `photo_url`; any `name` sent in the same request is ignored. Image falls back to the default fundraising image when the contact has no `photo_url`.\n\n**Investor link:** `investorId` links the fundraising to an investor by giving it the investor's website and domain; see the field description.",
		"inputSchema": {
			"allOf": [
				{
					"properties": {
						"fields": {
							"description": "Custom field values keyed by field ID. For fields of type `company`, provide either a company ID or a domain string (e.g. `\"stripe.com\"`). For `company-list` fields, provide an array of company IDs and/or domain strings. For fields of type `deal`, provide a deal ID. For `deal-list` fields, provide an array of deal IDs. For `contacts-list` fields, provide an array of contact IDs. For `contact` fields, provide a single contact ID (an empty string clears it). For `url-link` fields, provide either a URL string or an object `{ url, title }`. Fields of type `ai-research` are read-only: their value is produced by background LLM research and cannot be set through the API.",
							"type": "object"
						},
						"investorId": {
							"description": "ID of the investor to link this fundraising to. The investor must exist in the caller's organization — the request fails with 404 if not. The fundraising adopts the investor's website and domain, replacing any website it has or that is sent in the same request, and takes the investor's image when the investor has one. An investor saved without a website links through its generated domain, which reads back as an empty `website`.",
							"pattern": "^[0-9a-fA-F]{24}$",
							"type": "string"
						},
						"name": {
							"type": "string"
