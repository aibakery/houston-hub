					},
					{
						"const": "id"
					}
				]
			},
			"files.ListRevisionsMode.path": {
				"anyOf": [
					{
						"description": "Returns revisions with the same file path as identified by the latest file entry at the\n given file path or id.",
						"properties": {
							".tag": {
								"$ref": "#/$defs/FilesListRevisionsModePathTag"
							}
						},
