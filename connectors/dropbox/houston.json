{
  "connection_label": [
    {
      "if": "{{ isDefined auth.oauth }}",
      "request": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account"
      },
      "select": "/email"
    }
  ],
  "schema_version": 2,
  "name": "Dropbox",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "access": [
    {
      "name": "files",
      "label": "Files",
      "description": "Find, read, download, upload and organize files and folders.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    },
    {
      "name": "sharing",
      "label": "Sharing",
      "description": "Shared links, shared folders and files, and their members.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    },
    {
      "name": "file_requests",
      "label": "File requests",
      "description": "Requests that let others upload files to your Dropbox.",
      "levels": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "read",
          "label": "Read"
        },
        {
          "value": "write",
          "label": "Write"
        }
      ],
      "default": "read"
    }
  ],
  "config": {
    "folder_policy": {
      "default": false,
      "description": "Houston limits file operations to the folders you list; sharing, file requests and batch operations become unavailable.",
      "label": "Limit to folders",
      "order": 1,
      "type": "boolean"
    },
    "path_access": {
      "default": "{\n  \"/Finance\": \"read-only\",\n  \"/Incoming\": \"read-write\"\n}",
      "description": "Give each folder read-only or read-write. read-write folders also need Write for Files. Unlisted folders are denied, and the most specific rule wins.",
      "format": "json",
      "if": "{{ is config.folder_policy true }}",
      "label": "Folder access JSON",
      "multiline": true,
      "order": 2,
      "required": true,
      "type": "string"
    }
  },
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account"
      },
      "authorize_params": {
        "token_access_type": "offline"
      },
      "authorize_url": "https://www.dropbox.com/oauth2/authorize",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect with Dropbox",
      "brand": "dropbox",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "account_info.read"
          ]
        },
        {
          "if": "{{ allows access.files \"read\" }}",
          "values": [
            "files.metadata.read",
            "files.content.read"
          ]
        },
        {
          "if": "{{ allows access.sharing \"read\" }}",
          "values": [
            "sharing.read"
          ]
        },
        {
          "if": "{{ allows access.file_requests \"read\" }}",
          "values": [
            "file_requests.read"
          ]
        },
        {
          "if": "{{ allows access.files \"write\" }}",
          "values": [
            "files.content.write"
          ]
        },
        {
          "if": "{{ allows access.sharing \"write\" }}",
          "values": [
            "sharing.write"
          ]
        },
        {
          "if": "{{ allows access.file_requests \"write\" }}",
          "values": [
            "file_requests.write"
          ]
        }
      ],
      "token_url": "https://api.dropboxapi.com/oauth2/token",
      "type": "oauth2"
    }
  },
  "publisher": {
    "client_id": {
      "label": "Dropbox app key",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "Dropbox app secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.dropboxapi.com",
          "content.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/*"
        ],
        "protocol": "http"
      }
    }
  ]
}
