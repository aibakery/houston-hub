{
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account"
      },
      "authorize_params": {
        "token_access_type": "offline"
      },
      "authorize_url": "https://www.dropbox.com/oauth2/authorize",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "label": "Connect account",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "account_info.read",
            "files.metadata.read",
            "files.content.read"
          ]
        }
      ],
      "token_url": "https://api.dropboxapi.com/oauth2/token",
      "type": "oauth2"
    }
  },
  "description": "Read-only access to Dropbox files and account info.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Dropbox",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/users/get_current_account",
          "/2/files/search/continue_v2",
          "/2/files/list_folder/continue",
          "/2/files/search_v2",
          "/2/files/list_folder",
          "/2/files/get_metadata"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "content.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/files/download"
        ],
        "protocol": "http"
      }
    }
  ],
  "publisher": {
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "schema_version": 1,
  "setup": "Houston will ask Dropbox for permission, then keep the token on this server. Your files stay in Dropbox."
}
