{
  "schema_version": 1,
  "name": "Dropbox",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "type": "string",
      "label": "Access",
      "default": "read-only",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        }
      ]
    },
    "client_id": {
      "type": "string",
      "label": "Dropbox app key",
      "required": true,
      "order": 1
    },
    "client_secret": {
      "type": "secret",
      "label": "Dropbox app secret",
      "required": true,
      "order": 2
    }
  },
  "auth": {
    "oauth": {
      "type": "oauth2",
      "label": "Connect with Dropbox",
      "authorize_url": "https://www.dropbox.com/oauth2/authorize",
      "token_url": "https://api.dropboxapi.com/oauth2/token",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "client_auth": "body",
      "pkce": "S256",
      "require_refresh": true,
      "authorize_params": {
        "token_access_type": "offline"
      },
      "scopes": [
        {
          "values": [
            "account_info.read",
            "files.metadata.read",
            "files.content.read",
            "sharing.read",
            "file_requests.read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "files.content.write",
            "sharing.write",
            "file_requests.write"
          ]
        }
      ],
      "account": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account",
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email"
      }
    }
  },
  "proxy": [
    {
      "match": {
        "protocol": "http",
        "host": [
          "api.dropboxapi.com",
          "content.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/*"
        ]
      },
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      }
    }
  ]
}
