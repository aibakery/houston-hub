{
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account"
      },
      "authorize_params": {
        "token_access_type": "offline"
      },
      "authorize_url": "https://www.dropbox.com/oauth2/authorize",
      "client_auth": "body",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "label": "Connect account",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "account_info.read",
            "files.metadata.read",
            "files.content.read"
          ]
        }
      ],
      "token_url": "https://api.dropboxapi.com/oauth2/token",
      "type": "oauth2"
    }
  },
  "config": {
    "client_id": {
      "label": "OAuth client ID",
      "order": 1,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "label": "OAuth client secret",
      "order": 2,
      "required": true,
      "type": "secret"
    }
  },
  "description": "Read-only access to Dropbox files and account info.",
  "files": [
    "connector.lua"
  ],
  "icon": "icon.svg",
  "name": "Dropbox",
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/users/get_current_account",
          "/2/files/search/continue_v2",
          "/2/files/list_folder/continue",
          "/2/files/search_v2",
          "/2/files/list_folder",
          "/2/files/get_metadata"
        ],
        "protocol": "http"
      }
    },
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "content.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/files/download"
        ],
        "protocol": "http"
      }
    }
  ],
  "schema_version": 1,
  "setup": "Create an OAuth application with your provider and enter its client ID and client secret in this connection's settings. Copy the OAuth callback URL shown here into that application's allowed redirect URLs before authorizing. Every Houston connection gets a different callback URL; reauthorizing the same connection keeps it. Houston will ask Dropbox for permission, then keep the token on this server. Your files stay in Dropbox."
}
