{
  "schema_version": 1,
  "name": "Dropbox",
  "files": [
    "connector.luau"
  ],
  "icon": "icon.svg",
  "config": {
    "access": {
      "default": "read-only",
      "label": "Access",
      "options": [
        {
          "label": "Read-only",
          "value": "read-only"
        },
        {
          "label": "Read and write",
          "value": "read-write"
        },
        {
          "label": "Custom folder access",
          "value": "custom"
        }
      ],
      "type": "string"
    },
    "client_id": {
      "if": "{{ is config.own_app true }}",
      "label": "Dropbox app key",
      "order": 3,
      "required": true,
      "type": "string"
    },
    "client_secret": {
      "if": "{{ is config.own_app true }}",
      "label": "Dropbox app secret",
      "order": 4,
      "required": true,
      "type": "secret"
    },
    "own_app": {
      "default": false,
      "label": "Use your own Dropbox app",
      "order": 2,
      "type": "boolean"
    },
    "path_access": {
      "default": "{\n  \"/Finance\": \"read-only\",\n  \"/Incoming\": \"read-write\"\n}",
      "description": "Unlisted folders are denied; the most specific rule wins.",
      "format": "json",
      "if": "{{ is config.access \"custom\" }}",
      "label": "Folder access JSON",
      "multiline": true,
      "order": 1,
      "required": true,
      "type": "string"
    }
  },
  "auth": {
    "oauth": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.oauth.access_token}}"
          }
        },
        "label": "/email",
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account"
      },
      "authorize_params": {
        "token_access_type": "offline"
      },
      "authorize_url": "https://www.dropbox.com/oauth2/authorize",
      "client_auth": "body",
      "client_id": "{{publisher.client_id}}",
      "client_secret": "{{publisher.client_secret}}",
      "if": "{{ is config.own_app false }}",
      "label": "Connect with Dropbox",
      "brand": "dropbox",
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "account_info.read",
            "files.metadata.read",
            "files.content.read",
            "sharing.read",
            "file_requests.read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "files.content.write",
            "sharing.write",
            "file_requests.write"
          ]
        },
        {
          "if": "{{ is config.access \"custom\" }}",
          "values": [
            "files.content.write"
          ]
        }
      ],
      "token_url": "https://api.dropboxapi.com/oauth2/token",
      "type": "oauth2"
    },
    "own_app": {
      "account": {
        "headers": {
          "Authorization": {
            "value": "Bearer {{auth.own_app.access_token}}"
          }
        },
        "label": "/email",
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/users/get_current_account"
      },
      "authorize_params": {
        "token_access_type": "offline"
      },
      "authorize_url": "https://www.dropbox.com/oauth2/authorize",
      "client_auth": "body",
      "client_id": "{{config.client_id}}",
      "client_secret": "{{config.client_secret}}",
      "if": "{{ is config.own_app true }}",
      "label": "Connect with your Dropbox app",
      "brand": "dropbox",
      "order": 1,
      "pkce": "S256",
      "require_refresh": true,
      "scopes": [
        {
          "values": [
            "account_info.read",
            "files.metadata.read",
            "files.content.read",
            "sharing.read",
            "file_requests.read"
          ]
        },
        {
          "if": "{{ is config.access \"read-write\" }}",
          "values": [
            "files.content.write",
            "sharing.write",
            "file_requests.write"
          ]
        },
        {
          "if": "{{ is config.access \"custom\" }}",
          "values": [
            "files.content.write"
          ]
        }
      ],
      "token_url": "https://api.dropboxapi.com/oauth2/token",
      "type": "oauth2"
    }
  },
  "publisher": {
    "client_id": {
      "label": "Dropbox app key",
      "order": 1,
      "type": "string"
    },
    "client_secret": {
      "label": "Dropbox app secret",
      "order": 2,
      "type": "secret"
    }
  },
  "proxy": [
    {
      "action": {
        "headers": {
          "set": {
            "Authorization": "Bearer {{auth.oauth.access_token || auth.own_app.access_token}}"
          }
        }
      },
      "match": {
        "host": [
          "api.dropboxapi.com",
          "content.dropboxapi.com"
        ],
        "method": [
          "POST"
        ],
        "path": [
          "/2/*"
        ],
        "protocol": "http"
      }
    }
  ]
}
